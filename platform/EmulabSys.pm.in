#
# Returns an (IPaddr,netmask,bcast) tuple
#
sub getIfaceInfo($$\$\$\$) {
    my $self = shift;
    return undef 
	if (!ref($self));

    die "Your platform does not implement the `getIfaceInfo' method!";
}

