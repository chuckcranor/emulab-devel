use strict;
use libdb;

sub DoUpdate($$$)
{
    my ($dbhandle, $dbname, $version) = @_;

    if (!DBSlotExists("projects", "shared_reservations")) {
	DBQueryFatal("alter table projects add ".
		     " `shared_reservations` tinyint(1) default '1'");
    }
    return 0;
}
1;

