use strict;
use libdb;

sub DoUpdate($$$)
{
    my ($dbhandle, $dbname, $version) = @_;

    if (!DBSlotExists("login", "last_access")) {
	DBQueryFatal("ALTER TABLE login ADD ".
		     " `last_access` datetime NOT NULL ".
		     "      default '0000-00-00 00:00:00'");
    }
    return 0;
}
1;

