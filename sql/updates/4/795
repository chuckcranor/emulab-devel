use strict;
use libdb;

sub DoUpdate($$$)
{
    my ($dbhandle, $dbname, $version) = @_;

    if (DBTableExists("nonlocal_users") &&
	DBSlotExists("nonlocal_users", "email")) {
	DBQueryFatal("DROP TABLE IF EXISTS `nonlocal_users`");
    }
    if (!DBTableExists("nonlocal_users")) {
	DBQueryFatal("CREATE TABLE `nonlocal_users` ( ".
		     " `nonlocal_id` varchar(128) NOT NULL default '', ".
		     " `uid_idx` mediumint(8) unsigned NOT NULL default '0', ".
		     " `unix_uid` int(10) unsigned NOT NULL default '0', ".
		     " `created` datetime default NULL, ".
		     " PRIMARY KEY  (`nonlocal_id`), ".
		     " UNIQUE KEY `uid_idx` (`uid_idx`), ".
		     " UNIQUE KEY `unix_uid` (`unix_uid`) ".
		     ") ENGINE=MyISAM DEFAULT CHARSET=latin1");
    }
    return 0;
}
1;

