use strict;
use libdb;

sub DoUpdate($$$)
{
    my ($dbhandle, $dbname, $version) = @_;

    if( !DBSlotExists("future_reservations", "gid" ) ) {
	DBQueryFatal( "ALTER TABLE future_reservations ADD ".
		      " `gid` varchar(32) NOT NULL DEFAULT ''" );
	DBQueryFatal( "UPDATE future_reservations SET gid=pid" );
    }
    if( !DBSlotExists("future_reservations", "gid_idx" ) ) {
	DBQueryFatal( "ALTER TABLE future_reservations ADD ".
		      " `gid_idx` mediumint(8) unsigned NOT NULL DEFAULT '0'" );
	DBQueryFatal( "UPDATE future_reservations SET gid_idx=pid_idx" );
    }
    if( !DBSlotExists("reservation_history", "gid" ) ) {
	DBQueryFatal( "ALTER TABLE reservation_history ADD ".
		      " `gid` varchar(32) NOT NULL DEFAULT ''" );
	DBQueryFatal( "UPDATE reservation_history SET gid=pid" );
    }
    if( !DBSlotExists("reservation_history", "gid_idx" ) ) {
	DBQueryFatal( "ALTER TABLE reservation_history ADD ".
		      " `gid_idx` mediumint(8) unsigned NOT NULL DEFAULT '0'" );
	DBQueryFatal( "UPDATE reservation_history SET gid_idx=pid_idx" );
    }

    if( !DBSlotExists("apt_reservation_groups", "gid" ) ) {
	DBQueryFatal( "ALTER TABLE apt_reservation_groups ADD ".
		      " `gid` varchar(32) NOT NULL default '' after pid_idx" );
	DBQueryFatal( "UPDATE apt_reservation_groups SET gid=pid" );
    }
    if( !DBSlotExists("apt_reservation_groups", "gid_idx" ) ) {
	DBQueryFatal( "ALTER TABLE apt_reservation_groups ADD ".
		      " `gid_idx` mediumint(8) unsigned NOT NULL DEFAULT '0' ".
		      " after gid" );
	DBQueryFatal( "UPDATE apt_reservation_groups SET gid_idx=pid_idx" );
    }
    if( !DBSlotExists("apt_reservation_group_history", "gid" ) ) {
	DBQueryFatal( "ALTER TABLE apt_reservation_group_history ADD ".
		      " `gid` varchar(32) NOT NULL default '' after pid_idx" );
	DBQueryFatal( "UPDATE apt_reservation_group_history SET gid=pid" );
    }
    if( !DBSlotExists("apt_reservation_group_history", "gid_idx" ) ) {
	DBQueryFatal( "ALTER TABLE apt_reservation_group_history ADD ".
		      " `gid_idx` mediumint(8) unsigned NOT NULL DEFAULT '0' ".
		      " after gid" );
	DBQueryFatal( "UPDATE apt_reservation_group_history ".
		      "  SET gid_idx=pid_idx" );
    }
    if( !DBSlotExists("apt_reservation_history_details", "gid" ) ) {
	DBQueryFatal( "ALTER TABLE apt_reservation_history_details ADD ".
		      " `gid` varchar(32) default NULL after pid_idx" );
	DBQueryFatal( "UPDATE apt_reservation_history_details SET gid=pid" );
    }
    if( !DBSlotExists("apt_reservation_history_details", "gid_idx" ) ) {
	DBQueryFatal( "ALTER TABLE apt_reservation_history_details ADD ".
		      " `gid_idx` mediumint(8) unsigned NOT NULL DEFAULT '0' ".
		      " after gid" );
	DBQueryFatal( "UPDATE apt_reservation_history_details ".
		      "  SET gid_idx=pid_idx" );
    }
    if (!DBTableExists("apt_instance_prediction_info")) {
	DBQueryFatal("CREATE TABLE `apt_instance_prediction_info` ( ".	
		     " `uid` varchar(8) NOT NULL default '', ".
		     " `uid_idx` mediumint(8) unsigned NOT NULL default '0', ".
		     " `updated` datetime default NULL, ".
		     " `updating` datetime default NULL, ".
		     " `json_data` mediumtext, ".
		     " PRIMARY KEY  (`uid_idx`) ".
		     ") ENGINE=MyISAM DEFAULT CHARSET=latin1");
    }
    
    return 0;
}
1;

