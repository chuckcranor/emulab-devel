use strict;
use libdb;

sub DoUpdate($$$)
{
    my ($dbhandle, $dbname, $version) = @_;

    if (!DBTableExists("apt_instance_fabric_slices")) {
	DBQueryFatal("CREATE TABLE `apt_instance_fabric_slices` ( ".
		     " `uuid` varchar(40) NOT NULL default '', ".
		     " `linkname` varchar(32) NOT NULL default '', ".
		     " `sliceid` varchar(64) NOT NULL default '', ".
		     " PRIMARY KEY (`uuid`,`sliceid`), ".
		     " UNIQUE KEY (`uuid`,`linkname`) ".
		     ") ENGINE=MyISAM DEFAULT CHARSET=latin1");
    }
    return 0;
}
1;

