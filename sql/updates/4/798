    if (!DBSlotExists("apt_aggregate_radio_frontends", "rdz_radioport_id")) {
	DBQueryFatal("alter table apt_aggregate_radio_frontends add ".
		     " `rdz_radioport_id` varchar(40) DEFAULT NULL");
    }
    if (!DBSlotExists("apt_aggregate_radio_frontends", "rdz_monitor_id")) {
	DBQueryFatal("alter table apt_aggregate_radio_frontends add ".
