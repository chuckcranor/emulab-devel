    if (!DBSlotExists("apt_aggregate_nodes", "conflicting_nodes")) {
	DBQueryFatal("alter table apt_aggregate_nodes add ".
		     " `conflicting_nodes` mediumtext default NULL");
    }
    return 0;
}
