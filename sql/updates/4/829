use strict;
use libdb;

sub DoUpdate($$$)
{
    my ($dbhandle, $dbname, $version) = @_;

    if (!DBSlotExists("apt_instances", "private")) {
	DBQueryFatal("ALTER TABLE apt_instances add ".
		     " `private` tinyint(1) NOT NULL default '0'");
    }
    if (!DBSlotExists("experiments", "private")) {
	DBQueryFatal("ALTER TABLE experiments add ".
		     " `private` tinyint(1) NOT NULL default '0'");
    }
    return 0;
}
1;

