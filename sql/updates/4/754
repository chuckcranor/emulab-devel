use strict;
use libdb;

sub DoUpdate($$$)
{
    my ($dbhandle, $dbname, $version) = @_;

    if (!DBSlotExists("apt_instances", "sshpubkey")) {
	DBQueryFatal("ALTER TABLE apt_instances add " .
		     " `sshpubkey` mediumtext after privkey");
    }
    return 0;
}
1;

