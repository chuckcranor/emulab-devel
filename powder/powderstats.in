use strict;
use English;
use Getopt::Std;
use File::Basename;
use Date::Parse;

sub ShowActive();
sub usage()
{
    print STDERR "Usage: powderstats [-A] [-s YYYY-MM-DD] -e YYYY-MM-DD\n";
    print STDERR "  Print stats for projects/users/experiments created\n";
    print STDERR "  during the time period.\n";
    print STDERR "  -A        Print stats for projects/users/experiments that\n";
    print STDERR "            were active at any point in the time period.\n";
    print STDERR "  -P <list> Comma-separated list of projects to exclude\n";
    print STDERR "  -U <list> Comma-separated list of users to exclude\n";
    print STDERR "  -d   Debug output\n";
    exit(-1);
}
my $optlist   = "AP:U:de:s:";
my $STARTTIME;
my $ENDTIME;
my $showactive = 0;
my $debug = 0;

#
# Emulab start:    2000-11-09
#    Oldest experiment_stats.created value.
#
# Cloudlab start:  2014-09-04
#    Oldest apt_instance_history.created where portal='cloudlab'
#
# Powder start:    2017-10-26
#    Oldest apt_instance_history.created where portal='powder'
#
my $EPOCH = "2017-10-26";

#
# Projects to exclude from consideration. These are largely projects
# where we do debugging and development of the infrastructure.
#
#my @EXPROJ = ("emulab-ops", "testbed", "PMonitor", "openzms-demo");
my @EXPROJ = ("emulab-ops", "testbed", "PMonitor");

#
# Users who should not be included.
#
#my @EXUSER = ("zmstest", "dmjuser");
my @EXUSER = ();

#
# Email domains that should not be included.
# XXX this is a catch-all for "local users", but is not terribly accurate
# as many people use gmail or other external mail providers.
#
#my @EXMAIL = ("utah.edu", "rice.edu");
my @EXMAIL = ();

#
# Configure variables
#
my $TB		= "@prefix@";
my $WAP		= "$TB/sbin/withadminprivs";
my $NHIST       = "$TB/bin/node_history";

# un-taint path
$ENV{'PATH'} = '/bin:/usr/bin:/usr/local/bin:/usr/site/bin';
delete @ENV{'IFS', 'CDPATH', 'ENV', 'BASH_ENV'};

# Protos
sub fatal($);
	  
#
# Turn off line buffering on output
#
$| = 1; 

# Load the Testbed support stuff.
use lib "@prefix@/lib";
use emdb;
use libtestbed;
use Project;
use User;
use APT_Instance;

my %options = ();
if (! getopts($optlist, \%options)) {
    usage();
}
if (defined($options{"d"})) {
    $debug = 1;
}
if (defined($options{"A"})) {
    $showactive = 1;
}
if (defined($options{"P"})) {
    @EXPROJ = split(',', $options{"P"});
}
if (defined($options{"U"})) {
    @EXUSER = split(',', $options{"U"});
}
if (defined($options{"s"})) {
    $STARTTIME = $options{"s"};
    if (!str2time($STARTTIME)) {
	print STDERR "Cannot parse -s argument\n";
	exit(-1);
    }
} else {
    $STARTTIME = $EPOCH;
}
if (defined($options{"e"})) {
    $ENDTIME = $options{"e"};
    if (!str2time($ENDTIME)) {
	print STDERR "Cannot parse -e argument\n";
	exit(-1);
    }
} else {
    usage();
}

my $start = str2time($STARTTIME);
my $end = str2time($ENDTIME);
if ($start > $end) {
    print STDERR "Start date after end date\n";
    exit(1);
}
if ($start > time()) {
    print STDERR "Start date in the future\n";
    exit(1);
}
print "Stats from $STARTTIME to $ENDTIME\n";
print "Excluded projects: ", join(' ', @EXPROJ), "\n"
    if (@EXPROJ > 0);
print "Excluded users:    ", join(' ', @EXUSER), "\n"
    if (@EXUSER > 0);
print "Excluded emails:   ", join(' ', @EXMAIL), "\n"
    if (@EXMAIL > 0);
print "\n";

if ($showactive) {
    exit(ShowActive());
}

my $query_result;

#
# Legacy counts. So Kobus can get consistent numbers if needed.
# XXX note the hardwired projects and mail addresses to exclude, this is
# intentional.
#

#
# Number of projects.
#
$query_result =
    DBQueryFatal("select pid from projects as p ".
		 "left join users as u on u.uid_idx=p.head_idx ".
		 "where p.portal='powder' and p.approved=1 and ".
		 (defined($STARTTIME) ?
		  "     p.created > '$STARTTIME' and " : "") .
		 "      p.created < '$ENDTIME' and ".
		 "      u.usr_email not like '%utah.edu' and ".
		 "      u.usr_email not like '%rice.edu'");
print "Powder Portal projects: " . $query_result->numrows . "\n";

$query_result =
    DBQueryFatal("select uid_idx from users as u ".
		 "where u.portal='powder' and ".
		 "      (u.status='active' or u.status='inactive') and ".
		 (defined($STARTTIME) ?
		  "     u.usr_created > '$STARTTIME' and " : "") .
		 "      u.usr_created < '$ENDTIME' and ".
		 "      u.usr_email not like '%utah.edu' and ".
		 "      u.usr_email not like '%rice.edu'");
print "Powder Portal users: " . $query_result->numrows . "\n";

$query_result =
    DBQueryFatal("select uuid from apt_instance_history as h ".
		 "left join users as u on u.uid_idx=h.creator_idx ".
		 "where h.portal='powder' and ".
		 "     h.pid!='PMonitor' and ".
		 "     h.pid!='emulab-ops' and ".
		 "     h.pid!='testbed' and ".
		 (defined($STARTTIME) ?
		  "    h.created > '$STARTTIME' and " : "") .
		 "     h.created < '$ENDTIME' and ".
		 "     u.usr_email not like '%utah.edu' and ".
		 "     u.usr_email not like '%rice.edu'");
print "Powder Portal experiments: " . $query_result->numrows . "\n";

$query_result =
    DBQueryFatal("select h.creator,u.usr_name,h.pid, ".
		 "  count(h.creator) as ecount ".
		 "from apt_instance_history as h ".
		 "join users as u on u.uid_idx=h.creator_idx ".
		 "where h.portal='powder' and ".
		 "   u.usr_email not like '%utah.edu' and ".
		 "   u.usr_email not like '%rice.edu' and ".
		 (defined($STARTTIME) ?
		  "    h.created > '$STARTTIME' and " : "") .
		 "     h.created < '$ENDTIME' and ".
		 "   h.pid!='PMonitor' and ".
		 "   h.pid!='emulab-ops' and ".
		 "   h.pid!='testbed' ".
		 "group by h.creator,u.usr_name,h.pid ".
		 "order by ecount desc limit 20");

print "Top 20 powder users:\n";
while (my ($uid,$name,$pid,$ecount) = $query_result->fetchrow_array()) {
    print "  $uid, $name, $pid, $ecount\n";
}

$query_result =
    DBQueryFatal("select h.pid,count(h.pid) as ecount ".
		 "  from apt_instance_history as h ".
		 "join users as u on u.uid_idx=h.creator_idx ".
		 "join projects as p on p.pid_idx=h.pid_idx ".
		 "where h.portal='powder' and ".
		 "   u.usr_email not like '%utah.edu' and ".
		 "   u.usr_email not like '%rice.edu' and ".
		 (defined($STARTTIME) ?
		  "    h.created > '$STARTTIME' and " : "") .
		 "     h.created < '$ENDTIME' and ".
		 "   h.pid!='PMonitor' and ".
		 "   h.pid!='emulab-ops' and ".
		 "   h.pid!='testbed' ".
		 "group by h.pid ".
		 "order by ecount desc limit 20");

print "Top 20 powder projects:\n";
while (my ($pid,$ecount) = $query_result->fetchrow_array()) {
    print "  $pid, $ecount\n";
}

exit(0);

#
# The traditional Powder stats report is based around projects, users, and
# experiments *created* during the given time period with the Top 20 users
# and projects computed from experiments that started *and* ended during
# that period.
#
# "Active" experiments are those whose lifetime overlapped with the time
# period, possibly starting before the time period or ending after (or still
# running). The Top 20 users and project are then based on those experiments.
#
sub ShowActive()
{
    my %proj = ();
    my %user = ();
    my %uname = ();
    my %uproj = ();
    my $query_result;

    #
    # Build up sets of projects/users/email-addresses to exclude in the
    # counts. Maybe it would be better to fetch everything and exlude them
    # when we loop through the returned rows.
    #
    my $exprojclause = "";
    my $exuserclause = "";
    my $exmailclause = "";
if (0) {
    $exprojclause =
	"h.pid!='PMonitor' and ".
	"h.pid!='emulab-ops' and ".
	"h.pid!='testbed' and ";
    $exuserclause = "";
    $exmailclause =
	"u.usr_email not like '%utah.edu' and ".
	"u.usr_email not like '%rice.edu' and ";
} else {
    if (@EXPROJ) {
	my $list = join("','", @EXPROJ);
	$exprojclause = "not h.pid in ('$list') and ";
    }
    if (@EXUSER) {
	my $list = join("','", @EXUSER);
	$exuserclause = "not u.uid in ('$list') and ";
    }
    if (@EXMAIL) {
	my $list = join("','", @EXMAIL);
	foreach my $exm (@EXMAIL) {
	    $exmailclause .= "u.usr_email not like '%$exm' and ";
	}
    }
    if ($debug) {
	print STDERR "Proj clause: |$exprojclause|\n";
	print STDERR "User clause: |$exuserclause|\n";
	print STDERR "Mail clause: |$exmailclause|\n";
    }
}
    
    #
    # Experiments active.
    #
    my $query = 
	"select h.creator,u.usr_name,h.pid ".
	"from apt_instance_history as h ".
	"left join users as u on u.uid_idx=h.creator_idx ".
	"where h.portal='powder' and ".
	"    $exprojclause ".
	"    $exuserclause ".
	"    $exmailclause ".
	"    h.started is not NULL and h.started < '$ENDTIME' and ".
	"    h.destroyed > '$STARTTIME'";
    if ($debug) {
	print STDERR "Query: |$query|\n";
    }
    
    $query_result = DBQueryFatal($query);
    my $pastexp = $query_result->numrows;

    my $numproj = 0;
    my $numuser = 0;

    # Loop thru the experiments and record the projects and users (creators)
    while (my ($uid,$uname,$pid) = $query_result->fetchrow_array()) {
	if (!exists($proj{$pid})) {
	    $proj{$pid} = 1;
	    $numproj++;
	} else {
	    $proj{$pid}++;
	}
	if (!exists($user{$uid})) {
	    $user{$uid} = 1;
	    $uname{$uid} = $uname;
	    $uproj{$uid} = $pid;
	    $numuser++;
	} else {
	    $user{$uid}++;
	    # XXX users can be in multiple projects
	    if (!exists($uproj{$uid})) {
		$uproj{$uid} = $pid;
	    } elsif ($uproj{$uid} !~ /$pid/) {
		$uproj{$uid} .= "/$pid";
	    }
	}
    }

    $query =
	"select h.creator,u.usr_name,h.pid ".
	"from apt_instances as h ".
	"left join users as u on u.uid_idx=h.creator_idx ".
	"where h.portal='powder' and ".
	"    $exprojclause ".
	"    $exuserclause ".
	"    $exmailclause ".
	"    h.started is not NULL and h.started < '$ENDTIME'";
    if ($debug) {
	print STDERR "Query: |$query|\n";
    }
    $query_result =
	DBQueryFatal($query);
    my $curexp = $query_result->numrows;

    # Loop thru the experiments and record the projects and users (creators)
    while (my ($uid,$uname,$pid) = $query_result->fetchrow_array()) {
	if (!exists($proj{$pid})) {
	    $proj{$pid} = 1;
	    $numproj++;
	} else {
	    $proj{$pid}++;
	}
	if (!exists($user{$uid})) {
	    $user{$uid} = 1;
	    $uname{$uid} = $uname;
	    $uproj{$uid} = $pid;
	    $numuser++;
	} else {
	    $user{$uid}++;
	    # XXX users can be in multiple projects
	    if (!exists($uproj{$uid})) {
		$uproj{$uid} = $pid;
	    } elsif ($uproj{$uid} !~ /$pid/) {
		$uproj{$uid} .= "/$pid";
	    }
	}
    }

    # Number of experiments
    my $numexp = $pastexp + $curexp;
    print "Powder Portal experiments: $numexp";
    if ($debug) {
	print " (past=$pastexp, current=$curexp)";
    }
    print "\n";

    # Number of projects and users
    print "Powder Portal projects: $numproj\n";
    print "Powder Portal users: $numuser\n";

    # Top 20 users
    my @list = sort { $user{$b} <=> $user{$a} } keys %user;
    print "Top 20 powder users:\n";
    my $limit = int(@list) > 20 ? 20 : int(@list);
    for (my $i = 0; $i < $limit; $i++) {
	my $uid = $list[$i];
	print "  $uid, $uname{$uid}, $uproj{$uid}, $user{$uid}\n";
    }

    # Top 20 projects
    @list = sort { $proj{$b} <=> $proj{$a} } keys %proj;
    print "Top 20 powder projects:\n";
    $limit = int(@list) > 20 ? 20 : int(@list);
    for (my $i = 0; $i < $limit; $i++) {
	print "  $list[$i], $proj{$list[$i]}\n";
    }

    return(0);
}
