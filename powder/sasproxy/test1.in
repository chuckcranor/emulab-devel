use English;
use strict;
use Getopt::Std;
use Data::Dumper;
use Date::Parse;
use JSON;

sub usage()
{
    print "Usage: test\n";
    exit(1);
}
my $optlist   = "";

#
# Configure variables
#
my $TB		     = "@prefix@";
my $SRCDIR           = "@srcdir@";

# Load the Testbed support stuff.
use lib "@prefix@/lib";
use lib ".";
use emdb;
use emutil;
use sas;
use sasutil;

#
# Turn off line buffering on output
#
$| = 1;

my $device_a = sasutil::LoadJson("$SRCDIR/device_a.json");
print Dumper($device_a);

my $request = sas::Request::Registration->new($device_a);
my $response = $request->Send();
if (!$response) {
    die("No response to Registration");
}
$response->Dump();
if ($response->responseCode()) {
    die("Error returned by Registration");
}

my $spectrum = sas::Request::SpectrumInquiry->new($response->cbsdId(),
						  3550000000, 3700000000);
$spectrum->Dump();
my $spectrumResponse = $spectrum->Send();
if (!$spectrumResponse) {
    die("No response to spectruminquiry");
}
$spectrumResponse->Dump();
if ($spectrumResponse->responseCode()) {
    die("Error returned by spectrumInquiry");
}
my $slist = $spectrumResponse->availableChannels();
my $channel = $slist->[0];
print Dumper($channel);

my $grant = sas::Request::Grant->new($response->cbsdId(),
				     $channel->lowFrequency(),
				     $channel->highFrequency());
$grant->Dump();
my $grantResponse = $grant->Send();
if (!$grantResponse) {
    die("No response to Grant");
}
$grantResponse->Dump();
if ($grantResponse->responseCode()) {
    die("Error returned by Grant");
}

sleep(2);
my $heartbeat = sas::Request::Heartbeat->new($response->cbsdId(),
					     $grantResponse->grantId());
$heartbeat->Dump();
my $heartbeatResponse = $heartbeat->Send();
if (!$heartbeatResponse) {
    die("No response to Heartbeat");
}
$heartbeatResponse->Dump();
if ($heartbeatResponse->responseCode()) {
    die("Error returned by Heartbeat");
}

sleep(2);
$heartbeat->operationState("AUTHORIZED");
$heartbeatResponse = $heartbeat->Send();
if (!$heartbeatResponse) {
    die("No response to Heartbeat");
}
$heartbeatResponse->Dump();
if ($heartbeatResponse->responseCode()) {
    die("Error returned by Heartbeat");
}

sleep(2);
my $relinquishment = sas::Request::Relinquishment->new($response->cbsdId(),
					       $grantResponse->grantId());
$relinquishment->Dump();
my $relinquishmentResponse = $relinquishment->Send();
if (!$relinquishmentResponse) {
    die("No response to Relinquishment");
}
$relinquishmentResponse->Dump();
if ($relinquishmentResponse->responseCode()) {
    die("Error returned by Relinquishment");
}

my $deregistration = sas::Request::Deregistration->new($response->cbsdId());
$deregistration->Dump();
my $deregistrationResponse = $deregistration->Send();
if (!$deregistrationResponse) {
    die("No response to Deregistration");
}
$deregistrationResponse->Dump();
if ($deregistrationResponse->responseCode()) {
    die("Error returned by Deregistration");
}

