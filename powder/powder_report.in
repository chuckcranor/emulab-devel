use strict;
use English;
use Getopt::Std;
use File::Basename;
use Date::Parse;
use Data::Dumper;

sub usage()
{
    print STDERR "Usage: powder_report [-s YYYY-MM-DD] [-e YYYY-MM-DD] ".
	"[-p filename]\n";
    exit(-1);
}
my $optlist   = "s:e:p:PRB";
my $start     = "2020-04-01";
my $noprojects= 0;
my $remoteonly= 0;
my $busonly   = 0;
my $end;
my $pcsvname;

#
# Configure variables
#
my $TB		= "@prefix@";
my $WAP		= "$TB/sbin/withadminprivs";
my $NHIST       = "$TB/bin/node_history";

# un-taint path
$ENV{'PATH'} = '/bin:/usr/bin:/usr/local/bin:/usr/site/bin';
delete @ENV{'IFS', 'CDPATH', 'ENV', 'BASH_ENV'};

# Protos
sub fatal($);
	  
#
# Turn off line buffering on output
#
$| = 1; 

# Load the Testbed support stuff.
use lib "@prefix@/lib";
use emdb;
use libtestbed;
use Project;
use User;
use GeniXML;
use APT_Instance;
use APT_Aggregate;

my %options = ();
if (! getopts($optlist, \%options)) {
    usage();
}
if (defined($options{"e"})) {
    $end = $options{"e"};
    if (!str2time($end)) {
	print STDERR "Cannot parse -e argument\n";
	exit(-1);
    }
}
if (defined($options{"s"})) {
    $start = $options{"s"};
    if (!str2time($start)) {
	print STDERR "Cannot parse -s argument\n";
	exit(-1);
    }
}
if (defined($options{"p"})) {
    $pcsvname = $options{"p"};
}
if (defined($options{"P"})) {
    $noprojects = 1;
}
if (defined($options{"B"})) {
    $busonly = 1;
}
if (defined($options{"R"})) {
    $remoteonly = 1;
}

#
# Escape a string to go into a CSV file.
#
sub escapeString($)
{
    my ($str)  = @_;
    my @chars  = split('', $str);
    my $result = "";

    foreach my $ch (@chars) {
        if ($ch eq '\"') {
            $result = $result . "\"";
	}
        elsif (0 && $ch eq ',') {
            $result = $result . "\\";
	}
        elsif ($ch eq '\n') {
            $result = $result . '"\n"';
	    next;
	}
	$result = $result . "$ch";
    }
    return '"' . $result . '"';
}

#
# We deem these "compute" node types.
#
my %compute = (
    "pc3000" => 1,
    "d710"   => 1,
    "d430"   => 1,
    "d820"   => 1,
    "d740"   => 1,
    "d840"   => 1,
    );

#
# Sorted list of FEs for printing the CSV file. Need the Nickname.
#
my @FEList = ();
my @aggregates = APT_Aggregate->LookupAll();
foreach my $aggregate (@aggregates) {
    next
	if (!$aggregate->isFE());

    push(@FEList, $aggregate->nickname());
}
@FEList = sort(@FEList);

#
# Cache of instances that correspond to underlying emulab experiment.
#
my %instances = ();

#
# Array of projects, storing an array of experiments, storing an
# array of node types with counts.
#
my %stats = ();

#
# Another CSV file of just project details
#
my @projects = ();

#
# Run node history on the mothership to get the usage for all nodes.
# Process the lines. Kinda painful, but I do not want to dip inside
# node_histry today. And who came up the -d/-t arguments? Sheesh.
#
my $dopt = "";
my $topt = "";

if (defined($end)) {
    $dopt = str2time($end);
    $topt = "-t " . ($dopt - str2time($start));
}
else {
    $dopt = str2time($start);
}
if (!$remoteonly) {
if (!open(HIST, "$WAP $NHIST -l -a -r -A -d $dopt $topt |")) {
    die("Could not start $NHIST");
}
while (<HIST>) {
    #print $_;
    chomp($_);
    my ($node_id, undef, undef,
	$seconds, $uid, $pid, $eid, $exptidx) = split(" ", $_);

    my $project = Project->Lookup($pid);
    if (!defined($project)) {
	print STDERR "No such project $pid\n";
	next;
    }
    my $query_result =
	DBQueryFatal("select slice_uuid from experiment_stats ".
		     "where exptidx='$exptidx' and slice_uuid is not null");
    next
	if (!$query_result->numrows);

    my ($slice_uuid) = $query_result->fetchrow_array();
    my $instance;

    if (exists($instances{$slice_uuid})) {
	$instance = $instances{$slice_uuid};
    }
    else {
	$instance = APT_Instance::History->LookupBySlice($slice_uuid);
	if (!defined($instance)) {
	    $instance = APT_Instance->LookupBySlice($slice_uuid);
	}
	if (!defined($instance)) {
	    #print STDERR "No entry $pid/$eid/$exptidx/$slice_uuid\n";
	    next;
	}
	$instances{$slice_uuid} = $instance;
    }
    next
	if ($instance->portal() ne "powder");
    
    my $creator = $project->GetLeader();
    if (!defined($project)) {
	print STDERR "No leader for project $pid\n";
	next;
    }
    if ($creator->email() =~ /utah\.edu$/ ||
	$creator->email() =~ /rice\.edu$/) {
	next;
    }

    # Do not worry if node is gone (happens a lot, VMs).
    my $node = Node->Lookup($node_id);
    next
	if (!defined($node));
    my $type = $node->type();

    if (!exists($stats{$pid})) {
	$stats{$pid} = {};
	push(@projects, $project);
    }
    if (!exists($stats{$pid}->{$exptidx})) {
	$stats{$pid}->{$exptidx} = {
	    "duration" => $seconds,
	    "started"  => str2time($instance->started()),
	    "eid"      => $eid,
            "uid"      => $uid,
	    "types"    => {},
            "cbrssdr"  => 0,
            "cellsdr"  => 0,
            "mmimo"    => 0,
            "iris"     => 0,
            "ota-nuc"  => 0,
            "ota-x310" => 0,
            "oai-wb"   => 0,
            "phantom"  => 0,
            "FE-nuc1"  => 0,
            "FE-nuc2"  => 0,
	    "buses"    => 0,
            "compute"  => 0,
	};
    }
    my $types = $stats{$pid}->{$exptidx}->{"types"};
    if (!exists($types->{$type})) {
	$types->{$type} = 0;
    }
    $types->{$type} += 1;
    #
    # Now combine usage into compute,radios,mmimo,etc
    #
    if ($node_id =~ /^cbrssdr/) {
	$stats{$pid}->{$exptidx}->{"cbrssdr"} += 1;
    }
    elsif ($node_id =~ /^cellsdr/) {
	$stats{$pid}->{$exptidx}->{"cellsdr"} += 1;
    }
    elsif ($type eq "faros_sfp") {
	$stats{$pid}->{$exptidx}->{"mmimo"} += 1;
    }
    elsif ($type eq "iris030") {
	$stats{$pid}->{$exptidx}->{"iris"} += 1;
    }
    elsif ($node_id =~ /^ota-nuc/) {
	$stats{$pid}->{$exptidx}->{"ota-nuc"} += 1;
    }
    elsif ($node_id =~ /^ota-x310/) {
	$stats{$pid}->{$exptidx}->{"ota-x310"} += 1;
    }
    elsif ($node_id =~ /^oai-wb/) {
	$stats{$pid}->{$exptidx}->{"oai-wb"} += 1;
    }
    elsif ($type eq "nuc5300") {
	$stats{$pid}->{$exptidx}->{"phantom"} += 1;
    }
    elsif (exists($compute{$type})) {
	$stats{$pid}->{$exptidx}->{"compute"} += 1;
    }
}
}

my $query_result =
    DBQueryFatal("select h.uuid,h.pid,h.creator,h.name,ia.aggregate_urn, ".
		 "      ia.physnode_count,aa.nickname, ".
                 "      (UNIX_TIMESTAMP(h.destroyed) - ".
                 "        UNIX_TIMESTAMP(h.started)) as seconds, ".
		 "      h.started,s.exptidx,aa.isFE,aa.ismobile".
		 "  from apt_instance_history as h ".
		 "left join apt_instance_failures as f on ".
		 "     f.uuid=h.uuid ".
                 "left join apt_instance_aggregate_history as ia on ".
                 "     ia.uuid=h.uuid ".
                 "left join apt_aggregates as aa on aa.urn=ia.aggregate_urn ".
		 "left join experiment_stats as s on ".
		 "     s.slice_uuid=h.slice_uuid ".
		 "left join users as u on u.uid_idx=h.creator_idx ".
		 "where h.started is not null and ".
		 "      h.started > '$start' and ".
		 (defined($end) ? "h.started < '$end' and " : "") .
#		 "      f.uuid is null and ".
		 "      u.usr_email not like '%utah.edu' and ".
		 "      u.usr_email not like '%rice.edu' and ".
		 "      h.pid!='PMonitor' and ".
		 "      h.pid!='emulab-ops' and ".
		 "      h.pid!='testbed' and ".
		 "      (aa.isFE=1 or aa.ismobile=1)");

while (my ($uuid,$pid,$uid,$eid,$aggregate_urn,$count,$nickname,$seconds,
	   $started,$exptidx,$isFE,$ismobile) =
       $query_result->fetchrow_array()) {

    #
    # We prune projects as above.
    #
    my $project = Project->Lookup($pid);
    if (!defined($project)) {
	print STDERR "No such project $pid\n";
	next;
    }
    next
	if (!$project->isPowder());
    
    my $creator = $project->GetLeader();
    if (!defined($creator)) {
	print STDERR "No leader for project $pid\n";
	next;
    }
    if ($creator->email() =~ /utah\.edu$/ ||
	$creator->email() =~ /rice\.edu$/) {
	next;
    }
    if (!exists($stats{$pid})) {
	$stats{$pid} = {};
	push(@projects, $project);
    }
    if (!defined($exptidx)) {
	$exptidx = $uuid;
    }
    if (!exists($stats{$pid}->{$exptidx})) {
	$stats{$pid}->{$exptidx} = {
	    "duration" => $seconds,
	    "started"  => str2time($started),
	    "eid"      => $eid,
            "uid"      => $uid,
	    "types"    => {},
            "cbrssdr"  => 0,
            "cellsdr"  => 0,
            "mmimo"    => 0,
            "iris"     => 0,
            "ota-nuc"  => 0,
            "ota-x310" => 0,
            "oai-wb"   => 0,
            "phantom"  => 0,
            "FE-nuc1"  => 0,
            "FE-nuc2"  => 0,
	    "buses"    => 0,
            "compute"  => 0,
	};
    }
    my $instance;

    if (exists($instances{$uuid})) {
	$instance = $instances{$uuid};
    }
    else {
	$instance = APT_Instance::History->Lookup($uuid);
	if (!defined($instance)) {
	    #print STDERR "No history entry $pid/$eid/$uuid\n";
	    next;
	}
	$instances{$uuid} = $instance;
    }
    if ($ismobile) {
	$stats{$pid}->{$exptidx}->{"buses"} += 1;
    }
    else {
	my $agg = $instance->AggregateHash()->{$aggregate_urn};
	
	if (!defined($agg)) {
	    #print STDERR "No history entry $pid/$eid/$uuid/$aggregate_urn\n";
	    next;
	}
	my $manifest = $agg->Manifest();
	if (!defined($manifest)) {
	    #print STDERR "No manifest $pid/$eid/$uuid/$aggregate_urn\n";
	    next;
	}
	foreach my $ref (GeniXML::FindNodes("n:node", $manifest)->get_nodelist()) {
	    my $client_id    = GeniXML::GetVirtualId($ref);
	    my $vnoderef     = GeniXML::GetVnode($ref);
	    if (!defined($vnoderef)) {
		next;
	    }
	    my $node_id = GeniXML::GetText("name", $vnoderef);
	    if ($node_id eq "nuc1") {
		$stats{$pid}->{$exptidx}->{"FE-nuc1"} += 1;
	    }
	    else {
		$stats{$pid}->{$exptidx}->{"FE-nuc2"} += 1;
	    }
	}
    }
}

#print Dumper(\%stats);

if (!$noprojects) {
    # The output stream for the project CSV file.
    my $POUT = *STDOUT;
    if ($pcsvname) {
	open(PCSV, "> $pcsvname") or
	    die("Could not create $pcsvname: $!\n");
	$POUT = *PCSV;
    }
    print $POUT "project,leader,email,NSF awards,description\n";
    foreach my $project (@projects) {
	my $creator = $project->GetLeader();
	my @awards  = $project->NSFAwardList();
    
	print $POUT $project->pid() . "," . $creator->uid() . "," .
	    $creator->email() . ",";
	if (@awards) {
	    print $POUT escapeString(join(",", @awards));
	}
	print $POUT ",";
	print $POUT escapeString($project->why()) . "\n";
    }
    if ($pcsvname) {
	close(PCSV);
    }
    else {
	print $POUT "\n";
    }
}

print "project,experiment,user,email,started,duration,compute,shared,cbrssdr,cellsdr,mmimo,iris,ota-nuc,ota-x310,oai-wb,phantomnet,FE-nuc1,FE-nuc2,buses\n";

foreach my $pid (sort(keys(%stats))) {
    foreach my $idx (sort(keys(%{$stats{$pid}}))) {
	my $ref      = $stats{$pid}->{$idx};
	my $eid      = $ref->{'eid'};
	my $uid      = $ref->{'uid'};
	my $started  = $ref->{'started'};
	my $seconds  = $ref->{'duration'};
	my $cbrssdr  = $ref->{"cbrssdr"};
	my $cellsdr  = $ref->{"cellsdr"};
	my $mmimo    = $ref->{"mmimo"};
	my $iris     = $ref->{"iris"};
	my $ota_nuc  = $ref->{"ota-nuc"};
	my $ota_x310 = $ref->{"ota-x310"};
	my $oai_wb   = $ref->{"oai-wb"};
	my $phantom  = $ref->{"phantom"};
	my $FE_nuc1  = $ref->{"FE-nuc1"};
	my $FE_nuc2  = $ref->{"FE-nuc2"};
	my $buses    = $ref->{"buses"};
	my $compute  = $ref->{"compute"};
	my $types    = $ref->{'types'};
	my $shared   = 0;
	my $email    = "";

	my $user = User->Lookup($uid);
	if ($user) {
	    $email = $user->email();
	}

	#
	# XXX VMs with no compute means shared nodes. List them as shared
	#
	if ($compute == 0 && exists($types->{"pcvm"})) {
	    $shared = 1;
	}

	next
	    if ($busonly && !$buses);

	print "$pid,$eid,$uid,$email,$started,$seconds,$compute,$shared,";
	print "$cbrssdr,$cellsdr,$mmimo,$iris,$ota_nuc,$ota_x310,$oai_wb,";
	print "$phantom,$FE_nuc1,$FE_nuc2,$buses\n";
    }
}
