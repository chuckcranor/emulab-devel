[Unit]
Description=Force udev to settle before systemd-networkd starts
DefaultDependencies=no
After=local-fs.target
Before=systemd-networkd.service
Before=systemd-networkd.socket

[Install]
RequiredBy=systemd-networkd.service
RequiredBy=systemd-networkd.socket

[Service]
Type=oneshot
ExecStart=/bin/sh -c ". /etc/emulab/paths.sh ; exec $BINDIR/emulab-udev-settle-networkd.sh"
Restart=on-failure
RemainAfterExit=false
TimeoutStartSec=2min
