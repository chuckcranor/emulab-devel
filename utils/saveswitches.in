#
# XXX this should probably be part of the switch backup process.
# It isn't because I am not sure we want to do this every night
# (like we do with saving the running state offline)
# and because it either involves multiple sshs to the switches or
# that we figure out how to execute multiple commands in one line
# via the CLI.
#
# XXX don't know how to do this on all switch types either.
# We cannot just do "sudo ssh moonshot-switch 'save force'" for example,
# the Moonshot ssh server just aborts without doing anything. Might
# have to script it interactively with expect.
#

my $BACKUPDIR = '@prefix@/backup/switch-config';
my $TMPFILE = "/tftpboot/switch-backup";
my $GRAB = "@prefix@/sbin/grabswitchconfig";

use lib '@prefix@/lib';
use libdb;
use lib '@prefix@/lib/snmpit';
use snmpit_lib;

use strict;
use English;

sub usage() {
    print "Usage: saveswitches <switches...>\n";
    exit 1;
}

if ($UID && !TBAdmin($UID)) {
    die "*** $0:\n" .
        "    Sorry, only admins get to run this script\n";
}

if (!@ARGV) {
    usage();
}

#
# Back up each switch in turn
#
unlink $TMPFILE;
foreach my $switch (@ARGV) {
    #
    # Is it a Cisco or maybe an HP
    my $type = getDeviceType($switch);
    if ($type !~ /(arista|cisco|catalyst|hp|force10|dellrest)/) {
	print STDERR
	    " *** $0:\n" .
	    "     ignoring unsupported switch type (type $type)\n";
	next;
    }
    if ($type =~ /(cisco|catalyst)/) {
	print "$switch: nothing to do on Cisco switches\n";
	next;
    }
    if ($type =~ /hp/) {
	print STDERR "*** $switch: TBD for HP switches\n";
	next;
    }
    if ($type =~ /(force10|dellrest|arista)/) {
	if (system("ssh toor\@$switch write memory")) {
	    if (($? >> 8) != 255) {
		print STDERR "*** $switch: unable to write config for $switch ($?)\n";
	    } else {
		print STDERR "*** $switch: could not SSH to $switch\n";
	    }
	} else {
	    print "$switch: done\n";
	}
    }
}

exit(0);
