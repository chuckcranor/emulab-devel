<ptop xmlns="http://emulab.net/resources/ptop/0.1" testbed="emulab">
    <node name="pc1">
        <node_type>
            <type_name>pc</type_name>
            <type_slots>1</type_slots>
        </node_type>
        <unique/>
        <trivial_bw>100</trivial_bw>
    </node>
    <node name="pc2">
        <node_type>
            <type_name>pc</type_name>
            <type_slots>1</type_slots>
        </node_type>
        <fd>
            <fd_name>fast</fd_name>
            <fd_weight>0.0</fd_weight>
        </fd>
        <subnode_of>pc1</subnode_of>
    </node>
    <link name="pc1-pc2">
        <source_interface>
            <interface>
                <node_name>pc1</node_name>
                <interface>eth0</interface>
            </interface>
        </source_interface>
        <destination_interface>
            <interface>
                <node_name>pc2</node_name>
                <interface>eth0</interface>
            </interface>
        </destination_interface>
        <bandwidth>100</bandwidth>
        <latency>10</latency>
        <packet_loss>0.0</packet_loss>
        <link_type>
            <type_name>ethernet</type_name>
        </link_type>
        <foo/>
    </link>
</ptop>
