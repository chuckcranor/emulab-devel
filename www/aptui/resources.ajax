chdir("..");
include_once("geni_defs.php");
chdir("apt");
include_once("profile_defs.php");
include_once("instance_defs.php");

function Do_ResourceList()
{
    global $this_user, $ajax_args;

    if (!(ISADMIN() || isforeign_ADMIN())) {
	SPITAJAX_ERROR(-1, "Not enough permission");
        return;
    }

    $query_result =
                  DBQueryFatal("select uuid from apt_instances order by pid");

    $instances = array();
    while ($row = mysql_fetch_array($query_result)) {
        $uuid      = $row["uuid"];
        $instance  = Instance::Lookup($uuid);
        $slivers   = array();
        if (!$instance) {
            continue;
        }
        foreach ($instance->slivers() as $sliver) {
            if ($sliver->status() != "terminated" && $sliver->manifest()) {
                $slivers[$sliver->aggregate_urn()] = array(
                    "name"     => $sliver->aggregate_name(),
                    "manifest" => $sliver->manifest(),
                );
            }
        }
        if (!count($slivers)) {
            continue;
        }
        $blob = array(
            "name"      => $instance->name(),
            "pid"       => $instance->pid(),
            "creator"   => $instance->creator(),
            "portal"    => $instance->portal(),
            "started"   => DateStringGMT($instance->started()),
            "expires"   => DateStringGMT($instance->expires()),
            "slivers"   => $slivers,
        );
        $instances[$uuid] = $blob;
    }
    SPITAJAX_RESPONSE($instances);
}

