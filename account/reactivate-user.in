use English;
use strict;
use Getopt::Std;
use Data::Dumper;

#
# Reactivate a single user.
# The main reason for this script is to check the user's permissions
# and if not leading a project, and has not logged in for a "long" time,
# their permissions are reset to "user" in their projects. This throws
# the decision to the PI(s) to determine if a long absent user 
#
my $interval = 24;	# months

sub usage()
{
    print("Usage: reactivate-user [-n] [-I interval] <user>\n".
	  "Options:\n".
	  " -n       - Just show what would be done\n".
	  " -I <int> - Number of months to consider setting perms to 'user'\n".
	  "            Defaults to $interval months\n");
    exit(-1);
}
my $optlist    = "nI:";
my $impotent   = 0;
my @projects   = ();

#
# Configure variables
#
my $TB		= "@prefix@";
my $TBOPS       = "@TBOPSEMAIL@";
my $OURDOMAIN   = "@OURDOMAIN@";
my $WAP         = "$TB/sbin/withadminprivs";
my $TBACCT      = "$TB/sbin/tbacct";
my $MODGROUPS   = "$TB/sbin/modgroups";
my $SUDO	= "/usr/local/bin/sudo";
my $PROTOUSER   = "elabman";

#
# Untaint the path
#
$ENV{'PATH'} = "$TB/bin:$TB/sbin:/bin:/usr/bin:/usr/bin:/usr/sbin";
delete @ENV{'IFS', 'CDPATH', 'ENV', 'BASH_ENV'};

#
# Turn off line buffering on output
#
$| = 1;

#
# Load the Testbed support stuff.
#
use lib "@prefix@/lib";
use libdb;
use libtestbed;
use User;
use Project;
use Group;
sub fatal($);

#
# Parse command arguments. Once we return from getopts, all that should be
# left are the required arguments.
#
my %options = ();
if (! getopts($optlist, \%options)) {
    usage();
}
if (defined($options{"n"})) {
    $impotent = 1;
}
if (defined($options{"I"})) {
    $interval = int($options{"I"});
    if (!$interval || $interval < 12) {
	print STDERR "I don't think so...\n";
	exit(0);
    }
}
usage()
    if (@ARGV != 1);

my $this_user = User->ThisUser();
if (! defined($this_user)) {
    fatal("You ($UID) do not exist!");
}
if (!$this_user->IsAdmin()) {
    fatal("Only admins can use this script!");
}

my $target_user = User->Lookup($ARGV[0]);
if (!defined($target_user)) {
    fatal("Target user does not exist");
}
if ($target_user->status() ne USERSTATUS_INACTIVE) {
    fatal("User is not inactive");
}

#
# Determine if we are going to change perms to "user" and projects;
#
my $lastlogin = $target_user->LastWebLogin();
if (!defined($lastlogin)) {
    # XXX If never logged in, use the account creation date
    $lastlogin = $target_user->CreatedTimestamp();
    if (!defined($lastlogin)) {
	fatal("Error getting user last web login");
    }
    if ($impotent) {
	print "Would use account creation date '$lastlogin'\n";
    }
} elsif ($impotent) {
    print "Would use last login date '$lastlogin'\n";
}
if (time() - $lastlogin > (30 * 24 * 3600 * $interval)) {
    my @tmp;
    
    if ($target_user->ProjectMembershipList(\@tmp)) {
	fatal("Could not get project membership list");
    }
    foreach my $project (@tmp) {
	#
	# If the user is a leader of a project, do not reset perms.
	#
	if ($project->IsLeader($target_user)) {
	    @projects = ();
	    last;
	}
	push(@projects, $project);
    }
}

#
# Must reactivate before doing the project membership changes.
# Cause a deactivated user homedir is not mounted on ops.
#
# Need force so that tbacct changes the user status from inactive.
#
if ($impotent) {
    print "Would reactivate (with -f) $target_user\n";
}
else {
    system("$TBACCT -f reactivate " . $target_user->uid());
    if ($?) {
	fatal("Could not reactivate user account");

    }
}

foreach my $project (@projects) {
    my $pid = $project->pid();
    my $t = $Group::MemberShip::TRUSTSTRING_USER;

    if ($impotent) {
	print "Would reset perms to 'user' in $pid\n";
	next;
    }
    system("$MODGROUPS -s -m $pid:$pid:$t " . $target_user->uid());
    if ($?) {
	# Ick, deactivated again
	system("$TBACCT -f deactivate " . $target_user->uid());
	fatal("Could not reactivate user");
    }
}
exit(0);

sub fatal($) {
    my($mesg) = $_[0];

    die("*** $0:\n".
	"    $mesg\n");
}

