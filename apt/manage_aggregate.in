use English;
use strict;
use Getopt::Std;
use Getopt::Long;
use XML::Simple;
use Data::Dumper;
use CGI;
use POSIX ":sys_wait_h";
use POSIX qw(:signal_h ceil);
use Date::Parse;

#
# Futz around with aggregate settings.
#
sub usage()
{
    print STDERR "Usage: manage_aggregate list\n";
    print STDERR "       manage_aggregate add [options ...] \n";
    print STDERR "       manage_aggregate delete <urn>\n";
    print STDERR "       manage_aggregate [agg] show \n";
    print STDERR "       manage_aggregate [agg] chflag <flag> yes|no\n";
    print STDERR "       manage_aggregate [agg] ping [-s]\n";
    print STDERR "       manage_aggregate [agg] portals add <portal> \n";
    print STDERR "       manage_aggregate [agg] portals rem <portal> \n";
    print STDERR "       manage_aggregate [agg] feature set <feature> \n";
    print STDERR "       manage_aggregate [agg] feature clear \n";
    print STDERR "       manage_aggregate [agg] status up|down \n";
    print STDERR "Options:\n";
    print STDERR "  agg   - URN, nickname, abbrev, or domain of aggregate\n";
    exit(-1);
}
my $optlist     = "d";
my $debug       = 0;

#
# Configure variables
#
my $TB		= "@prefix@";
my $TBOPS       = "@TBOPSEMAIL@";
my $OURDOMAIN	= "@OURDOMAIN@";
my $MYURN	= "urn:publicid:IDN+${OURDOMAIN}+authority+cm";

#
# Untaint the path
#
$ENV{'PATH'} = "$TB/bin:$TB/sbin:/bin:/usr/bin:/usr/bin:/usr/sbin";
delete @ENV{'IFS', 'CDPATH', 'ENV', 'BASH_ENV'};

#
# Turn off line buffering on output
#
$| = 1;

#
# Load the Testbed support stuff.
#
use lib "@prefix@/lib";
use EmulabConstants;
use emdb;
use emutil;
use Brand;
use libtestbed;
use APT_Geni;
use APT_Aggregate;
use APT_Utility;
use GeniHRN;

# Locals
my $aggregate;
my $action;

# Protos
sub fatal($);
sub DoList();
sub DoShow();
sub DoFlags();
sub DoPing();
sub DoPortals();
sub DoFeature();
sub DoStatus();
sub DoCreate();
sub DoDelete();

#
# Parse command arguments. Once we return from getopts, all that should be
# left are the required arguments.
#
my %options = ();
if (! getopts($optlist, \%options)) {
    usage();
}
if (defined($options{"d"})) {
    $debug++;
}
if (!@ARGV) {
    usage();
}
$action = shift(@ARGV);
if ($action ne "list" && $action ne "add" && $action ne "delete") {
    if ($action =~ /^(show|chflag|ping|portals|feature)$/) {
	# Default to local cluster
	$aggregate = APT_Utility::LookupAggregate($MYURN);
    }
    else {
	usage()
	    if (!@ARGV);
	$aggregate = APT_Utility::LookupAggregate($action);
	$action    = shift(@ARGV);
    }
    if (!defined($aggregate)) {
	fatal("Could not lookup aggregate");
    }
}

my $this_user = User->ThisUser();
if (! defined($this_user)) {
    fatal("You ($UID) do not exist!");
}

if ($action eq "show") {
    DoShow();
}
elsif ($action eq "list") {
    DoList();
}
elsif ($action eq "add") {
    DoCreate();
}
elsif ($action eq "delete") {
    DoDelete();
}
elsif ($action eq "chflag") {
    DoFlags();
}
elsif ($action eq "ping") {
    DoPing();
}
elsif ($action eq "portals") {
    DoPortals();
}
elsif ($action eq "feature") {
    DoFeature();
}
elsif ($action eq "status") {
    DoStatus();
}
else {
    usage();
}
exit(0);

#
# Brief aggregate list.
#
sub DoList()
{
    my %options = ();
    if (! getopts($optlist, \%options)) {
	usage();
    }
    usage()
	if (@ARGV);

    my @aggregates = APT_Aggregate->LookupAll(1);
    exit(0)
	if (!@aggregates);

    printf("%-30s %-15s %s\n", "Name", "Nickname", "Abbrev");
    printf("--------------------------------------------------------------\n");

    my @sorted = sort { $a->name() cmp $b->name() } @aggregates;

    foreach my $aggregate (@sorted) {
	printf("%-30s %-15s %s\n",
	       $aggregate->name(), $aggregate->nickname(),
	       $aggregate->abbreviation());
    }
    return 0;
}

#
# Show aggregate details.
#
sub DoShow()
{
    my $optlist = "";
    
    my %options = ();
    if (! getopts($optlist, \%options)) {
	usage();
    }
    usage()
	if (@ARGV);

    print "Name:            " . $aggregate->name() . "\n";
    print "NickName:        " . $aggregate->nickname() . "\n";
    print "Abbrev:          " . $aggregate->abbreviation() . "\n"; 
    print "URN:             " . $aggregate->urn() . "\n";
    print "URL:             " . $aggregate->weburl() . "\n";
    print "Disabled:        " . ($aggregate->disabled() ? "Yes" : "No") . "\n";
    print "Admin:           " . ($aggregate->adminonly() ? "Yes" : "No") . "\n";
    print "Federate:        " . ($aggregate->isfederate() ? "Yes" : "No") . "\n";
    print "FE               " . ($aggregate->isFE() ? "Yes" : "No") . "\n";
    print "Mobile:          " . ($aggregate->ismobile() ? "Yes" : "No") . "\n";
    print "NoUpdate:        " . ($aggregate->noupdate() ? "Yes" : "No") . "\n";
    print "NoMonitor:       " . ($aggregate->nomonitor() ? "Yes" : "No") . "\n";
    print "Deferrable:      " . ($aggregate->deferrable() ? "Yes" : "No") . "\n";
    print "Datasets:        " . ($aggregate->has_datasets() ? "Yes" : "No") ."\n";
    print "Reservations:    " . ($aggregate->reservations() ? "Yes" : "No") ."\n";
    print "SyncThing:       " . ($aggregate->does_syncthing() ? "Yes" : "No") ."\n";
    print "LocalImages:     " . ($aggregate->nolocalimages() ? "No" : "Yes")."\n";
    print "PrestageImages:  " . ($aggregate->prestageimages() ? "Yes":"No")."\n";
    print "PanicPowerOff:   " . ($aggregate->panicpoweroff() ? "Yes" : "No")."\n";
    print "PreCalcMaxExt:   " . ($aggregate->precalcmaxext() ? "Yes" : "No")."\n";
    print "Portals:         " . $aggregate->portals() . "\n";
    if ($aggregate->latitude() && $aggregate->longitude()) {
	print "Latitude:        " . $aggregate->latitude() . "\n";
	print "Longitude:       " . $aggregate->longitude() . "\n";
    }
    print "Use Feature:     " . ($aggregate->canuse_feature() || "") . "\n";
    print "Status:          " . $aggregate->status() . "\n";
    return 0;
}

#
# Change flags
#
sub DoFlags()
{
    my $optlist = "";
    
    my %options = ();
    if (! getopts($optlist, \%options)) {
	usage();
    }
    usage()
	if (@ARGV != 2 || $ARGV[1] !~ /^(yes|no)$/);

    my $flag  = $ARGV[0];
    my $onoff = $ARGV[1] eq "yes" ? 1 : 0;

    SWITCH: for ($flag) {
	/^disabled$/ && do {
	    $aggregate->Update({"disabled" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^(admin|adminonly)$/ && do {
	    $aggregate->Update({"adminonly" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^federate$/ && do {
	    $aggregate->Update({"isfederate" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^fe$/ && do {
	    $aggregate->Update({"isFE" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^mobile$/ && do {
	    $aggregate->Update({"ismobile" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^noupdate$/ && do {
	    $aggregate->Update({"noupdate" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^nomonitor$/ && do {
	    $aggregate->Update({"nomonitor" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^deferrable$/ && do {
	    $aggregate->Update({"deferrable" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^datasets$/ && do {
	    $aggregate->Update({"has_datasets" => $onoff}) == 0
		or fatal("Could not update flafg");
	    last;
	};
	/^reservations$/ && do {
	    $aggregate->Update({"reservations" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^localimages$/ && do {
	    $aggregate->Update({"nolocalimages" => $onoff ? 0 : 1}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^prestageimages$/ && do {
	    $aggregate->Update({"prestageimages" => $onoff ? 1 : 0}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^panicpoweroff$/ && do {
	    $aggregate->Update({"panicpoweroff" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^precalcmaxext$/ && do {
	    $aggregate->Update({"precalcmaxext" => $onoff}) == 0
		or fatal("Could not update flag");
	    last;
	};
	/^syncthing$/ && do {
	    $aggregate->Update({"does_syncthing" => $onoff}) == 0
		or fatal("Could not update flafg");
	    last;
	};
	fatal("Unknown flag");
    }
    return 0;
}

#
# Ping an aggregate to see if its alive.
#
sub DoPing()
{
    my $optlist = "s";
    my $fastrpc = 1;
    
    my %options = ();
    if (! getopts($optlist, \%options)) {
	usage();
    }
    if (defined($options{"s"})) {
	$fastrpc = 0;
    }
    usage()
	if (@ARGV);

    my $error;
    if ($aggregate->CheckStatus(\$error, $fastrpc)) {
	print STDERR $error . "\n";
	exit(1);
    }
}

#
# Change portals list for an aggregate.
#
sub DoPortals()
{
    my $optlist = "";
    
    my %options = ();
    if (! getopts($optlist, \%options)) {
	usage();
    }
    usage()
	if (@ARGV != 2);
    
    my $action = $ARGV[0];
    my $portal = $ARGV[1];

    fatal("Must be one of 'add' or 'rem'")
	if ($action ne "add" && $action ne "rem");

    fatal("Not a valid portal")
	if ($portal !~ /^(emulab|aptlab|cloudlab|phantomnet|powder)$/);

    my @portals = split(",", $aggregate->portals());

    if ($action eq "add") {
	push(@portals, $portal)
	    if (! grep {$_ eq $portal} @portals);
    }
    else {
	if (grep {$_ eq $portal} @portals) {
	    my @tmp = ();
	    foreach my $p (@portals) {
		push(@tmp, $p) if ($p ne $portal);
	    }
	    @portals = @tmp;
	}
    }
    $aggregate->Update({"portals" => join(",", @portals)}) == 0
	or fatal("Could not update portals");

    print "Portals set to: ". join(",", @portals) . "\n";
}

#
# Set or clear the canuse feature
#
sub DoFeature()
{
    my $optlist = "";
    
    my %options = ();
    if (! getopts($optlist, \%options)) {
	usage();
    }
    usage()
	if (@ARGV < 1 || @ARGV > 2);
    
    my $action = shift(@ARGV);

    fatal("Must be one of 'set' or 'clear'")
	if ($action ne "set" && $action ne "clear");

    if ($action eq "clear") {
	$aggregate->Update({"canuse_feature" => "NULL"}) == 0
	    or fatal("Could not clear feature");
    }
    else {
	usage()
	    if (!@ARGV);
	my $feature = shift(@ARGV);
	
	$aggregate->Update({"canuse_feature" => $feature}) == 0
	    or fatal("Could not set feature");
    }
}

#
# Change the status (in case the monitor is confused, or for debugging).
#
sub DoStatus()
{
    my $optlist = "";
    
    my %options = ();
    if (! getopts($optlist, \%options)) {
	usage();
    }
    usage()
	if (@ARGV < 1 || @ARGV > 2);
    
    my $which = shift(@ARGV);

    fatal("Must be one of 'up' or 'down' or 'offline'")
	if ($which ne "up" && $which ne "down" && $which ne "offline");
    
    $aggregate->status($which);
    $aggregate->StatusEvent($which);
}

#
# Create a new aggregate in the DB.
#
sub DoCreate()
{
    my $impotent = 0;
    my ($urn,$weburl,$name,$nickname,$abbrev,$busid,
	$portals,$latitude,$longitude,$canuseFeature);

    my $isfederate   = 0;
    my $isFE         = 0;
    my $ismobile     = 0;
    my $syncthing    = 0;
    my $datasets     = 0;
    my $reservations = 0;
    my $adminonly    = 0;
    my $disabled     = 0;
    
    my @strings = (
	"Options:",
	" -n                - Dry run mode",
	" -h                - Complete usage information",
	" --urn=            - URN of the new aggregate",
	" --weburl=         - URL of the new aggregate's web interface",
	" --name=           - Name (for example, 'Guest House' or 'Bus 6365')",
	" --nickname=       - Short name (for example, 'Guesthouse' or 'Bus6365'",
	" --abbrev=         - Even shorter name",
	" --isfederate      - Flag that aggregate is a Cloudlab federate",
	" --isFE            - Flag that aggregate is a Powder Fixed Endpoint",
	" --ismobile        - Flag that aggregate is a Powder Bus",
	" --busid           - With --ismoble, internal ID (for example, 6365)",
	" --syncthing       - Flag that aggregate runs syncthing",
	" --datasets        - Flag that aggregate hosts datasets",
	" --reservations    - Flag that aggregate allows resource reservations",
	" --portals         - Comma separated list of Portals allowed to use it",
	" --latitude        - Latitude of the aggregate",
	" --longitude       - Longitude of the aggregate",
	" --canuseFeature   - Radio zone: 'Indoor OTA Lab'",
	" --adminonly       - Radio zone: 'Indoor OTA Lab'",
	" --disabled        - Radio zone: 'Indoor OTA Lab'",
	);
    my $usage = sub {
	my ($message) = @_;

	if ($message) {
	    print STDERR "$message\n\n";
	}
	print STDERR "Usage: manage_aggregate add [-dn] [options] \n";
	foreach my $str (@strings) {
	    print STDERR $str . "\n";
	}
	exit(-1);
    };
    if (! GetOptions(
	      'n'		=> \$impotent,
	      "urn=s"		=> \$urn,
	      "name=s"		=> \$name,
	      "nickname=s"	=> \$nickname,
	      "abbrev=s"	=> \$abbrev,
	      "isfederate"	=> \$isfederate,
	      "isFE"		=> \$isFE,
	      "ismobile"	=> \$ismobile,
	      "weburl=s"	=> \$weburl,
	      "syncthing"	=> \$syncthing,
	      "datasets"	=> \$datasets,
	      "reservations"	=> \$reservations,
	      "portals=s"	=> \$portals,
	      "latitude=s"	=> \$latitude,
	      "longitude=s"	=> \$longitude,
	      "busid=s"		=> \$busid,
	      "disabled"	=> \$disabled,
	      "adminonly"	=> \$adminonly)) {
	&$usage();
    }
    &$usage("Missing required arguments ('=')")
	if (!($urn && $weburl && $name && $nickname && $abbrev));
    &$usage("Only one of isfederate, ismobile, isFE")
	if ($isfederate + $ismobile + $isFE > 1);
    &$usage("Most provide --busid with --ismobile")
	if ($ismobile && !$busid);
    &$usage("Not a valid URN")
	if (!GeniHRN::IsValid($urn));
    &$usage("Must provide both latitude and longitude")
	if (($latitude || $longitude) && !($latitude && $longitude));

    my %sets = (
	"urn"	   => $urn,
	"name"     => $name,
	"nickname" => $nickname,
	"weburl"   => $weburl,
	"abbreviation" => $abbrev,
    );
    $sets{"isfederate"} = 1
	if ($isfederate);
    $sets{"isFE"} = 1
	if ($isFE);
    $sets{"ismobile"} = 1
	if ($ismobile);
    $sets{"disabled"} = 1
	if ($disabled);
    $sets{"adminonly"} = 1
	if ($adminonly);
    $sets{"noupdate"} = 1
	if (!$isfederate);
    $sets{"nomonitor"} = 1
	if ($ismobile || !$isfederate);
    $sets{"nolocalimages"} = 1
	if ($ismobile || $isFE);
    $sets{"deferrable"} = 1
	if ($ismobile || $isFE);
    $sets{"has_datasets"} = 1
	if ($datasets);
    $sets{"does_syncthing"} = 1
	if ($syncthing);
    $sets{"panicpoweroff"} = 1
	if ($ismobile || $isFE);
    $sets{"reservations"} = 1
	if ($reservations);
    $sets{"latitude"} = 1
	if ($latitude);
    $sets{"longitude"} = 1
	if ($longitude);
    $sets{"canuse_feature"} = $canuseFeature
	if ($canuseFeature);

    my $sets = join(",", map("$_='$sets{$_}'", keys(%sets)));
    my $query = "insert into apt_aggregates set $sets";
    if ($impotent) {
	print "$query\n";
    }
    else {
	DBQueryFatal($query);
    }
    $query = "insert into apt_aggregate_status set ".
	"urn='$urn', 'up', now()";
    if ($impotent) {
	print "$query\n";
    }
    else {
	DBQueryWarn($query) or
	    (DeleteAggregate($urn) or exit(-1))
    }

    if ($ismobile) {
	$query = "insert into apt_mobile_aggregates set ".
	    "urn='$urn', type='bus'";
	if ($impotent) {
	    print "$query\n";
	}
	else {
	    DBQueryWarn($query) or
		(DeleteAggregate($urn) or exit(-1))
	}
	$query = "insert into apt_mobile_buses set ".
	    "urn='$urn', busid='$busid'";
	if ($impotent) {
	    print "$query\n";
	}
	else {
	    DBQueryWarn($query) or
		(DeleteAggregate($urn) or exit(-1))
	}
    }
    exit(0);
}

sub DeleteAggregate($)
{
    my ($urn) = @_;

    DBQueryFatal("delete from apt_mobile_buses where urn='$urn'");
    DBQueryFatal("delete from apt_mobile_aggregates where urn='$urn'");
    DBQueryFatal("delete from apt_aggregate_status where urn='$urn'");
    DBQueryFatal("delete from apt_aggregates where urn='$urn'");

    return 0;
}

#
# Create a new aggregate in the DB.
#
sub DoDelete()
{
    my $impotent = 0;
    
    my %options = ();
    if (! getopts($optlist, \%options)) {
	usage();
    }
    if (defined($options{"n"})) {
	$impotent = 0;
    }
    usage()
	if (@ARGV != 1);
    
    my $urn = shift(@ARGV);
    DeleteAggregate($urn);
    exit(0);
}

exit(0);

sub fatal($)
{
    my ($mesg) = @_;

    print STDERR "*** $0:\n".
	         "    $mesg\n";
    exit(-1);
}

