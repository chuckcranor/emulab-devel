SRCDIR		= @srcdir@
TESTBED_SRCDIR	= @top_srcdir@
OBJDIR		= ../..
SUBDIR		= apt/portal-rest
ISMAINSITE	= @TBMAINSITE@
SYSTEM         := $(shell uname -s)

include $(OBJDIR)/Makeconf

SUBDIRS		=
INSTALL_RESTDIR = $(TBROOT)/portal-rest

FILES		= config.py database.py __init__.py dependencies.py main.py
MODELFILE       = api/models.py
ROUTERS         = __init__.py experiments.py resgroups.py

#
# Force dependencies on the scripts so that they will be rerun through
# configure if the .in file is changed.
# 
all:	$(FILES) $(MODELFILE) $(addprefix routers/, $(ROUTERS))

include $(TESTBED_SRCDIR)/GNUmakerules

install: all \
	$(addprefix $(INSTALL_RESTDIR)/, $(FILES)) \
	$(INSTALL_RESTDIR)/$(MODELFILE) \
	$(addprefix $(INSTALL_RESTDIR)/routers/, $(ROUTERS))

portal-rest-install:

control-install:

fs-install:

tipserv-install:

clrhouse-install:

clean:

$(INSTALL_RESTDIR)/api/%: %
	@echo "Installing $<"
	-mkdir -p $(INSTALL_RESTDIR)/api
	$(INSTALL) $< $@

$(INSTALL_RESTDIR)/routers/%: %
	@echo "Installing $<"
	-mkdir -p $(INSTALL_RESTDIR)/routers
	$(INSTALL) $< $@

$(INSTALL_RESTDIR)/%: %
	@echo "Installing $<"
	-mkdir -p $(INSTALL_RESTDIR)
	$(INSTALL) $< $@

