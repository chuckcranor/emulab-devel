import os
import sys

TBROOT = "@prefix@"
TBPATH = os.path.join(TBROOT, "lib")
if TBPATH not in sys.path:
    sys.path.append(TBPATH)
    pass

EMULAB_CERT   = os.path.join(TBROOT, "etc", "emulab.pem")
TBSUEXEC_PATH = os.path.join(TBROOT, "libexec", "suexec")
DATABASE_URL  = "mysql+mysqldb://localhost/@TBDBNAME@"
