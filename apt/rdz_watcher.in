use strict;
use English;
use Getopt::Std;
use Data::Dumper;
use File::Basename;
use File::stat;
use REST::Client;
use POSIX ":sys_wait_h";
use JSON;

#
# RDZ experiment daemon; looks for experiments that need RDZ things.
#
sub usage()
{
    print "Usage: rdz_expdaemon [-d] [-s] [-n]\n";
    exit(1);
}
my $optlist   = "dns";
my $debug     = 0;
my $impotent  = 0;
my $oneshot   = 0;

#
# Configure variables
#
my $TB		= "@prefix@";
my $TBOPS       = "@TBOPSEMAIL@";
my $TBLOGS      = "@TBLOGSEMAIL@";
my $MAINSITE    = @TBMAINSITE@;
my $LOGFILE     = "$TB/log/rdz_watcher.log";
my $CURL        = "/usr/local/bin/curl";
my $APIKEY      = "\$2a\$04\$d4NTGF0FXkwL88gSZxxYweDq4YnIG.elnnRWLuLIf1BTzErT6BqT6";
my $CUSTOMERID  = "1000016324";
my $CSO         = "https://cso.celona.io";
my $STATSAPI    = "https://cso.celona.io/v1/api/stats";
my $CFGMAPI     = "https://cso.celona.io/v1/api/cfgm";

# un-taint path
$ENV{'PATH'} = '/bin:/usr/bin:/usr/local/bin:/usr/site/bin';
delete @ENV{'IFS', 'CDPATH', 'ENV', 'BASH_ENV'};

# Protos
sub GetEnodeBs($);
sub CreateClaim($$$);
sub fatal($);

#
# Turn off line buffering on output
#
$| = 1; 

#
# Check args early so we get the right DB.
#
my %options = ();
if (! getopts($optlist, \%options)) {
    usage();
}
if (defined($options{"d"})) {
    $debug = 1;
}
if (defined($options{"s"})) {
    $oneshot = 1;
}
if (defined($options{"n"})) {
    $impotent = 1;
}

# Load the Testbed support stuff.
use lib "@prefix@/lib";
use emdb;
use libtestbed;
use emutil;
use libEmulab;
use APT_RDZ;

#
# XXX We need to use our token to get out current element ID.
#
my $ELEMENTID = APT_RDZ::GetCelonaElementID();

#
# Need the radios.
#
my $response;
if (APT_RDZ::GET("/radios", \$response)) {
    fatal("Could not get RDZ /radios");
}
my @radios = @{ $response->{'radios'} };

if (!($oneshot || $impotent)) {
    if (CheckDaemonRunning("rdz_watcher")) {
	fatal("Not starting another rdz_watcher daemon!");
    }
    # Go to ground.
    if (! $debug) {
	if (TBBackGround($LOGFILE)) {
	    exit(0);
	}
    }
    if (MarkDaemonRunning("rdz_watcher")) {
	fatal("Could not mark daemon as running!");
    }
}

#
# Setup a signal handler for newsyslog.
#
sub LogHandler()
{
    my $SAVEEUID = $EUID;
    
    $EUID = 0;
    ReOpenLog($LOGFILE);
    $EUID = $SAVEEUID;
}
$SIG{HUP} = \&LogHandler
    if (! ($debug || $oneshot));


while (1) {
    my $enodebs;

    GetEnodeBs(\$enodebs);
    if ($enodebs) {
	#
	# Not going to worry about the APs getting different spectrum from
	# the SAS. They appear to get same spectrum.
	#
	my $enodeb = $enodebs->{'data'}->[0];
	my $radio  = $enodeb->{'radios'}->[0];
	my $min    = $radio->{'frequency_dl'};
	my $bw     = $radio->{'channel_bandwidth'};
	my $max    = $min + $bw;
	my $power  = $radio->{'default_max_transmit_power'};
	my $using  = $enodeb->{'using_sas'};
	if (0) {
	    print TBTimeStamp() . ": $min, $bw, $using\n";
	}
	else {
	    CreateClaim($min, $max, $power);
	}
    }
    last
	if ($oneshot);

    sleep(30);
}

#
# Create a new claim
#
sub CreateClaim($$$)
{
    my ($min,$max,$power) = @_;
    my @radio_ports = ();
    
    foreach my $radio (@radios) {
	foreach my $port (@{ $radio->{'ports'} }) {
	    my $port_id = $port->{'id'};
	    push(@radio_ports, {"radio_port_id" => $port_id });
	}
    }
    my $claim = {
	"element_id"  => $ELEMENTID,
	"ext_type"    => "cbrs-sas",
	"ext_name"    => "Google SAS",
	"starts_at"   => TBDateStringGMT(time()),
	"expires_at"  => JSON::null,
	"constraints" => [
	    {
		"min_freq"   => $min * 1000000,
		"max_freq"   => $max * 1000000,
		"max_eirp"   => $power + 0,
		"exclusive"  => JSON::false,
	    },
	],
	"radio_ports" => \@radio_ports,
    };
    if ($debug || $impotent) {
	print Dumper($claim);
    }
    if (!$impotent) {
	my $response;
	if (APT_RDZ::POST("/claims", $claim, \$response)) {
	    print "CreateClaim: Could not post claim\n"
	}
	print Dumper($response);
    }
}

#
# Ask the Celona API for the enodeB list.
#
sub GetEnodeBs($)
{
    my ($prval) = @_;
    my $client = REST::Client->new();

    $client->setHost($CSO);
    $client->addHeader("X-API-Key", $APIKEY);
    $client->GET("/v1/api/cfgm/enodebs?customerId=${CUSTOMERID}");

    if ($client->responseCode() ne "200") {
	print Dumper($client);
    }
    if ($client->responseContent()) {
	my $rval = eval { decode_json($client->responseContent()); };
	if ($@) {
	    print STDERR "Could not decode json\n";
	    return -1;
	}
	if ($client->responseCode() ne "200") {
	    print Dumper($rval);
	}
	$$prval = $rval;
    }
    if ($client->responseCode() ne "200") {
	return -1;
    }
    return 0;
}

sub fatal($)
{
    my ($msg) = @_;

    if (! ($oneshot || $debug)) {
	
	#
	# Send a message to the testbed list. 
	#
	SENDMAIL($TBOPS,
		 "rdz_watcher died",
		 $msg,
		 $TBOPS);
    }
    MarkDaemonStopped("rdz_watcher")
	if (!($oneshot || $impotent));

    die("*** $0:\n".
	"    $msg\n");
}
