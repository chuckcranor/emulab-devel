use strict;
use libinstall;
use installvars;

my $CRACK_PORT   = "cracklib";

sub Install($$$)
{
    my ($server, $isupdate, $impotent) = @_;

    # Replace if this script does an update for ip/domain.
    return 0
	if ($isupdate);

    Phase "cracklib", "Installing cracklib", sub {
	DoneIfPackageInstalled($CRACK_PORT, 0);
	if (!$packagedir) {
	    PhaseSkip("No package directory provided");
	}
	my $pname = GetPackage($CRACK_PORT, $packagedir);
	AddPackage($pname, $packagedir);
    };
    return 0;
}

