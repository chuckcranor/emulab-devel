#!/bin/sh
#
# Utah Network Testbed 
#
# PROVIDE: batterymon
# REQUIRE: testbed
# BEFORE: apache22
# KEYWORD: shutdown

case "$1" in
    start|faststart|quietstart|onestart|forcestart)
	if [ -x @prefix@/sbin/batterymon ]; then
	    echo -n " batterymon"
	    @prefix@/sbin/batterymon -v
	fi
	;;
    stop|faststop|quietstop|onestop|forcestop)
	if [ -r /var/run/battery_monitor.pid ]; then
	    kill `cat /var/run/battery_monitor.pid`
	fi
	;;
    *)
	echo ""
	echo "Usage: `basename $0` { start | stop }"
	echo ""
	exit 64
	;;
esac
exit 0
