subnet 10.10.11.0 netmask 255.255.255.0 {
	option subnet-mask		255.255.255.0;
	option routers                  10.10.11.2;
	option domain-name-servers      10.10.11.2;
	option domain-name              "@OURDOMAIN@";
	next-server			10.10.11.2;

	# Iris is on a private subnet.
	group {
		host 10.10.11.4 {
		    hardware ethernet 00:11:22:33:44:55;
		    option host-name "sdrn300";
		    fixed-address 10.10.11.4;
		}
	}
}
