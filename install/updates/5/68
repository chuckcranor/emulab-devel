sub InstallUpdate($$)
{
    my ($version, $phase) = @_;

    #
    # If something should run in the pre-install phase.
    #
    if ($phase eq "pre") {
	foreach my $file (@deletes) {
	    my $path = "$TBROOT/www/$file";

	    Phase $file, "Removing $path", sub {
		DoneIfDoesntExist($path);
		ExecQuietFatal("/bin/rm -f $path");
	    };
	}
    }
    
    #
    # If something should run in the post-install phase.
    #
    if ($phase eq "post") {
    }
    
    return 0;
}
