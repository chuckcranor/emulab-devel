SRCDIR		= @srcdir@
TESTBED_SRCDIR	= @top_srcdir@
OBJDIR		= ..
SUBDIR		= wbstore

SBIN_FILES	= createwbstore installwbstore wbstoremonitor
LIB_FILES	= WBStore.pm
DATA_FILES	= send-template.xml recv-template.xml \
		  recv-device-template.xml recv-folder-template.xml
INSTALL_DATADIR = $(INSTALL_TOPDIR)/wbstore/templates

include $(OBJDIR)/Makeconf

#
# Force dependencies on the scripts so that they will be rerun through
# configure if the .in file is changed.
# 
all: $(SBIN_FILES) $(LIB_FILES) $(DATA_FILES)

include $(TESTBED_SRCDIR)/GNUmakerules

install:

control-install: $(addprefix $(INSTALL_SBINDIR)/, $(SBIN_FILES)) \
	$(addprefix $(INSTALL_DATADIR)/, $(DATA_FILES))

clean: 
	rm -f $(SBIN_FILES) $(DATA_FILES)

$(INSTALL_DATADIR)/%: %
	@echo "Installing $<"
	-mkdir -p $(INSTALL_DATADIR)
	$(INSTALL_DATA) $< $@
