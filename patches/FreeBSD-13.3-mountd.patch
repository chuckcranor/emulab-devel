diff -Nur mountd.orig/Makefile mountd/Makefile
--- mountd.orig/Makefile	2024-03-14 21:16:29.100400000 -0600
+++ mountd/Makefile	2024-03-14 21:54:48.242442000 -0600
@@ -8,6 +8,9 @@
 CFLAGS+= -I${MOUNT}
 WARNS?= 2
 
+# Emulab-specific CFLAGS
+CFLAGS+= -DCACHE_ROOT_CRED -DTS_WHEN_DONE -DMOUNTD_STATS # -g # -pg -O0 # -DDEBUG
+
 .PATH: ${MOUNT}
 
 LIBADD=	util
