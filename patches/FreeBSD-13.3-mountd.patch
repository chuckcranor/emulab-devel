+TS_DEF(tsexport);	/* total time spend in the export function */
+TSC_DEF(rcalls);	/* export entries removed */
+TSC_DEF(icalls);	/* export entries inserted */
+TS_DEF(tse);
+
 /*
  * Get the export list from one, currently open file
  */
