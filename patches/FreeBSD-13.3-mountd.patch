+	       (cmpfailed ? "forced-full" : "incremental"),
+	       tsexport.tv_sec, tsexport.tv_usec);
+	syslog(LOG_INFO, "    %d export remove calls", rcalls);
+	syslog(LOG_INFO, "    %d export insert calls", icalls);
+	TS_ZERO(tsexport);
+	TSC_ZERO(rcalls);
+	TSC_ZERO(icalls);
+#endif
 }
 
