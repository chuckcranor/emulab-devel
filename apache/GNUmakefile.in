SRCDIR		= @srcdir@
TESTBED_SRCDIR	= @top_srcdir@
OBJDIR		= ..
SUBDIR		= apache

include $(OBJDIR)/Makeconf

CONFIG_FILES	= httpd.conf httpd.conf-ops \
		  httpd.conf.linux httpd.conf-ops.linux

SYSTEM          = $(shell uname -s)

HTTPD_CONFIG_POST = 
ifeq ($(SYSTEM),Linux)
HTTPD_CONFIG_POST = .linux
endif

#
# Force dependencies to make sure configure regenerates if the .in file
# is changed.
# 
all: $(CONFIG_FILES)

include $(TESTBED_SRCDIR)/GNUmakerules

# Like the INSTALL_ETCDIR target
$(INSTALL_APACHE_CONFIG)/%: %
	@echo "Installing $<"
	-mkdir -p $(INSTALL_APACHE_CONFIG)
	$(INSTALL_DATA) $< $@


install: httpd.conf$(HTTPD_CONFIG_POST)
	$(INSTALL_DATA) httpd.conf$(HTTPD_CONFIG_POST) $(INSTALL_APACHE_CONFIG)/httpd.conf

control-install: httpd.conf-ops
	$(INSTALL_DATA) httpd.conf-ops$(HTTPD_CONFIG_POST) $(INSTALL_APACHE_CONFIG)/httpd.conf

clean:
