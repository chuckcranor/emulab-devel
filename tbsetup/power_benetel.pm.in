# Perl module to power cycle Benetel RU devices, handling node event state
# machine transitions from the server side.

package power_benetel;

use lib "@prefix@/lib";
use libdb;
use libtestbed;
use EmulabConstants;
use Node;
use NodeType;
use strict;
use POSIX qw(strftime);
use English;
    
#
# Commands we run
#
my $TBROOT = '@prefix@';
my $BENESHELL = "$TBROOT/sbin/beneshell";

# Turn off line buffering on output
$| = 1;

#
# Create new Benetel power control object using wacky perl OO syntax.
# We store a reference to the node object passed in.
#
sub new($$) {
    my($class, $node) = @_;
    my $obj = {};

    $class = ref($class) if (ref($class));      # save class for blessing

    $obj->{'NODE'} = $node;

    bless($obj, $class);
    return($obj);
}

sub DESTROY($) {
    my $self = shift;

    $self->{'NODE'} = undef;
}

sub node($) { return $_[0]->{'NODE'}; }

# Do any required post-power operations.
sub DoPowerPostOp($$) {
    my ($self, $op) = @_;

    if ($op eq "on" || $op eq "cycle") {
	$self->launchEventSender();
    }
    elsif ($op eq "off") {
	# Nothing to do for the "off" operation.
    }
    
    return;
}

sub launchEventSender($) {
    my $self = shift;
    my $node = $self->node();
    my $node_id = $node->node_id();
    my $waittime = $node->NodeTypeInfo()->power_delay();

    # Fork and go into the background to proxy events for device.
    my $tmpfile = TBMakeTempFile("benetel-watcher");
    my $chpid = TBBackGround($tmpfile);
    if ($chpid) {
	$self->log("Benetel radio background event proxy launched (PID $chpid). Logging to file: $tmpfile");
	return;
    }
    TBdbfork();
    my $ecode = 0;
    # Send booting event (we assume the RU is now on and booting).
    $self->log("Benetel event proxy sending `BOOTING` event.");
    $node->SetEventState(TBDB_NODESTATE_BOOTING());
    # Wait for a while for the RU to ping, after which we consider it up.
    # Takes about a minute.
    $self->log("Waiting for device to become responsive.");
    system("$BENESHELL $node_id -q -P $waittime");
    if (! $?) {
	$self->log("Device is up. Sending `ISUP` event.");
	$node->SetEventState(TBDB_NODESTATE_ISUP());
	sleep(60);
	unlink $tmpfile;
    } else {
	$self->log("Timeout waiting for device. Sending `TBFAILED` event.");
	$node->SetEventState(TBDB_NODESTATE_TBFAILED());
	$ecode = 1;
    }

    exit $ecode;
}

sub log($$) {
    my ($self, $msg) = @_;
    my $node_id = $self->node()->node_id();
    my $tstamp = strftime("%F %T", localtime());
    print "[$tstamp][$PID][$node_id]: $msg\n";
}

# Needed at end of perl modules...
1;
