#
# snmpit module for cheap-o MSNswitch model UIS-722b remote IP switch or any
# device that supports the simple URL-based API described in:
# https://cloud4uis.com/doc/How+To+Control+Outlet+And+Get+Status+3208.pdf
#
# It is essentially a newer version of the original "5gstore" power controller
# but the API has changed enough that I just forked this off.
#
# N.B. the boss node running this code needs to be in the IP white list on
# the UIS device. As far as I can tell, it does not even use the autentication
# user/password info even if you provide it. It works if the IP is whitelisted
# and does not otherwise.
#
# supports new(ip), power(on|off|cyc[le],port), status
#

package power_uis722;

$| = 1; # Turn off line buffering on output

use strict;
use lib "@prefix@/lib";
use libdb;
use emutil;
use HTTP::Tiny;
use JSON;
use Data::Dumper;

sub Request($;$$);

sub new($$;$) {

    # The next two lines are some voodoo taken from perltoot(1)
    my $proto = shift;
    my $class = ref($proto) || $proto;

    my $devicename = shift;
    my $debug = shift;

    if (!defined($debug)) {
	$debug = 0;
    }

    if ($debug) {
	print STDERR "power_uis722 module initializing... debug level $debug\n";
    }

    my $self = {};

    $self->{DEBUG} = $debug;
    $self->{DEVICENAME} = $devicename;
    $self->{NUMOUTLETS} = 2;

    # Fetch authentication credentials from the DB.
    my $res = DBQueryFatal("select key_uid,mykey,key_role ".
			   "from outlets_remoteauth ". 
			   "where node_id='$devicename' and ".
			   "(key_role='web-passwd' or key_role='url-passwd')");
    if (!defined($res) || !$res || $res->num_rows() == 0) {
	warn "ERROR: No remote auth info for $devicename.\n";
	return undef;
    } else {
	my $row = $res->fetchrow_hashref();
	$self->{USERNAME} = $row->{'key_uid'};
	$self->{PASSWORD} = $row->{'mykey'};
    }

    bless($self,$class);
    return $self;
}

sub power {
    my $self = shift;
    my $op = shift;
    my @ports = @_;
    my $device = $self->{DEVICENAME};

    my $ctrl;
    if    ($op eq "on")  { $ctrl = 1; }
    elsif ($op eq "off") { $ctrl = 0; }
    elsif ($op =~ /cycle/) { $ctrl = 3; }

    my $errors = 0;

    foreach my $port (@ports) {
	print STDERR "**** Controlling port $port\n" if ($self->{DEBUG} > 1);
	print STDERR "operation is $op ($ctrl)\n" if ($self->{DEBUG} > 2);
	my $json = $self->Request($port, $ctrl);
	if (!$json) {
	    print STDERR "$device: Outlet #$port control failed.\n";
	    $errors++;
	    next;
	}
	print STDERR "Control returns: ", Dumper($json), "\n" if ($self->{DEBUG} > 1);
	#
	# Handle forcecycle and also do some sanity checks
	#
	if (!exists($json->{'outlet'})) {
	    print STDERR "$device: WARNING: No status returned from control call.\n";
	    next;
	}
	my @vals = @{$json->{'outlet'}};
	if (scalar(@vals) < $port) {
	    print STDERR "$device: WARNING: No status returned for outlet #$port.\n";
	    next;
	}

	#
	# If forcing and cycle did not result in the outlet being enabled,
	# do a power on.
	#
	my $stat = $vals[$port-1];
	if ($op eq "forcecycle" && $stat == 0) {
	    print STDERR "**** Cycle failed on port $port, turning on...\n" if ($self->{DEBUG});
	    $json = $self->Request($port, 1);
	    print STDERR "Control returns: ", Dumper($json), "\n" if ($self->{DEBUG} > 1);
	    @vals = @{$json->{'outlet'}};
	    $stat = $vals[$port-1];
	}
	if ($self->{DEBUG} &&
	    ($ctrl == 0 && $stat != 0 || $ctrl != 0 && $stat == 0)) {
	    print STDERR "**** port $port in wrong state after $op\n";
	}
    }

    return $errors;
}

sub status {
    my $self = shift;
    my $statusp = shift;
    my %status;

    print STDERR "**** Getting status for ports\n" if ($self->{DEBUG} > 1);
    my $noutlets = $self->{NUMOUTLETS};
    print STDERR "outlets: $noutlets\n" if ($self->{DEBUG} > 2);

    my $json = $self->Request();
    if (!$json || !exists($json->{'status'})) {
	print STDERR $self->{DEVICENAME}, ": no status from device\n";
	return 1;
    }
    my @vals = ();
    foreach my $oref (@{$json->{'status'}{'outlet'}}) {
	my $ix = 0;
	if ($oref->{name} =~ /^Outlet (\d+)$/) {
	    $ix = $1;
	    $vals[$ix-1] = $oref->{'status'};
	}
    }
    print STDERR "Status is '", join(' ', @vals), "'\n" if $self->{DEBUG};
    
    my $o = 1;
    foreach my $ostat (@vals) {
	my $outlet = "outlet$o";
	$status{$outlet} = $ostat;
	last if ($o++ > $noutlets);
    }

    if ($statusp) {
	%$statusp = %status;
    }
    return 0;
}

#
# Perform an operation on an outlet
#
sub Request($;$$)
{
    my ($self,$outlet,$action) = @_;
    my $url;
    my $isstatus = (!defined($outlet) || !defined($action)) ? 1 : 0;
    my $server = $self->{DEVICENAME};

    if ($isstatus) {
	$url = "http://$server/api/status";
    } else {
	my $paramstr = "?";
	## XXX it appears if we are coming from the whitelisted IP,
	## we do not even need authentication!
	#print STDERR "Using URL auth\n";
	#$paramstr .= "user=" . $self->{USERNAME} .
	#    "&passwd=" . $self->{PASSWORD} . "&";
	$outlet = "outlet$outlet";
	$action = $action == 0 ? "off" : ($action == 1 ? "on" : "reset");
	$paramstr .= "target=${outlet}&action=${action}";
	$url = "http://$server/api/control$paramstr";
    }
    print STDERR "GET URL: $url\n" if ($self->{DEBUG} > 2);

    my %headers = (
	"Accept-Encoding" => "gzip, deflate",
	"Accept" => "*/*"
    );
    my $http = HTTP::Tiny->new("timeout" => 30);
    my %options = ("headers" => \%headers);

    print STDERR "GET options: ", Dumper(\%options), "\n" if ($self->{DEBUG} > 2);
    my $res = $http->request("GET", $url, \%options);
    print STDERR "GET RESPONSE: ", Dumper($res), "\n" if ($self->{DEBUG} > 2);
    if ($res->{'success'} && $res->{'status'} == "200") {
	if ($res->{'headers'}{'content-type'} eq "application/json") {
	    my $json = eval { decode_json($res->{'content'}) };
	    if ($@) {
		print STDERR
		    "*** $server: decode_json failed on response string: $@\n";
		return undef;
	    }
	    return $json;
	}
	print STDERR "*** $server: Non-JSON content in response:\n";
	print STDERR Dumper($res->{'content'});
	return undef;
    }
    print STDERR "*** $server: Power control request failed:\n";
    print STDERR Dumper($res);
    return undef;
}

# End with true
1;
