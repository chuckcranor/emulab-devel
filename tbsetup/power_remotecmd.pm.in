# A little perl module to power cycle a mote attached to a stargate -
# basically just a wrapper for the tbsgmotepower script

package power_remotecmd;

use Exporter;
@ISA = ("Exporter");
@EXPORT = qw( remotecmdctrl );

#
# Commands we run
#
my $TBROOT = '@prefix@';
my $TBREMOTECMDPOWER = "$TBROOT/bin/tbremotecmdpower";

# Turn off line buffering on output
$| = 1;

# usage: remotecmdctrl(cmd, nodes)
# cmd = { "cycle" | "on" | "off" }
# nodes = list of one or more node names
#
# Returns 0 on success. Non-zero on failure.
# 
sub remotecmdctrl($@) {
    my ($cmd, @nodes) = @_;

    #
    # All we have to do is call tbremotecmdpower
    #
    print "Running $TBREMOTECMDPOWER $cmd " . join(" ",@nodes) . "\n";
    if (system("$TBREMOTECMDPOWER $cmd " . join(" ",@nodes))) {
	return 1;
    }
    else {
	return 0;
    }
}

1;
