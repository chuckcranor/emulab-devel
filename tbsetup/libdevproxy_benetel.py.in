##############################################################################
#
# BenetelWrapper class definition
#
class BenetelWrapper(DeviceWrapper):
    DEF_LOG_LEVEL = logging.INFO
    DEF_USER = "root"
    DEF_PASSWD = ""
    DEF_PING_TIMEOUT = 5
    DEF_BOOT_TIMEOUT = 120
    DEF_SHUTDOWN_TIME = 30
    DEF_RADIO_ONLINE_TIMEOUT = 300
    WAIT_LOG_SLEEP = 1
    FW_VERSION_UNKNOWN = {'major':'X', 'minor':'Y', 'revision':'Z'}
    FW_VERSION_FILE = "/etc/benetel-rootfs-version"
    RADIO_BOOT_LOG = "/tmp/logs/radio_status"
    RADIO_ONLINE_STATUS_PATTERN = r'^\[INFO\] Radio bringup complete'
    RADIO_SETUP_SCRIPT = "/usr/sbin/radio_setup_a.sh"
    RADIO_SETUP_SCRIPT_PATTERN = r'-w (C[0-9A-Fa-f]+) -x 0x([0-9A-Fa-f]+)'
    RADIO_CONFIG_FILE = "/etc/ru_config.cfg"
    RADIO_CONFIG_FILE_PATTERN = r'^\s*(\w+)\s*=\s*([.:\w]+)'
    SINGLE_FILE_SETTINGS_MAP = {
        'center_frequency': '/etc/ru-center-frequency-mhz',
        'bandwidth': '/etc/ru-bandwidth',
        'gain': '/etc/ru-tx-gain-db',
    }
    RADIO_SETUP_SCRIPT_SETTINGS = \
        ('fh_cplane_vlan', 'fh_uplane_vlan', 'du_cplane_mac',
         'du_uplane_mac')
    RADIO_CONFIG_FILE_MAP = {
        'mimo_mode': 'mimo_mode',
        'downlink_scaling': 'downlink_scaling',
        'prach_format': 'prach_format',
        'compression': 'compression',
        'lf_prach_compression_enable': 'lf_prach_compression_enable',
        'flexran_prach_workaround': 'flexran_prach_workaround',
        'bandwidth_hz': 'bandwidth',
        'centre_frequency_hz': 'center_frequency',
        'tx_power_dbm': 'gain',
        'c_plane_du_mac': 'du_cplane_mac',
        'u_plane_du_mac': 'du_uplane_mac',
        'c_plane_du_vlan': 'fh_cplane_vlan',
        'u_plane_du_vlan_downlink': 'fh_uplane_vlan',
        'u_plane_du_vlan_uplink': 'fh_uplane_vlan'
    }
    DEVCONF_MAP = {
        'RAN650': BenetelConfig_RAN650_b78,
        'RAN550': BenetelConfig_RAN550_b78
    }
    
    def __init__(self, mgmt_addr, username=DEF_USER, keyfile=None,
                 log_level = DEF_LOG_LEVEL):
        super().__init__(mgmt_addr, username, keyfile, log_level)

    def connect_session(self, password = DEF_PASSWD,
                        ping_timeout = DEF_PING_TIMEOUT):
        super().connect_session(password, ping_timeout)
        self._parse_fwversion(self._fwversion)

    def _parse_fwversion(self, fwstr):
        hw, version, *other = fwstr.split("-")
        major, minor, rev = version.split(".")
        major = major.split("v")[1]
        self._hardware = hw
        self._fwversion = { 'major': int(major), 'minor': int(minor),
                            'revision': int(rev) }

    def get_firmware_string(self):
        return ".".join([str(self._fwversion[x]) for x in
                         ("major", "minor", "revision")])

    def wait_for_radio_online(self, timeout = DEF_RADIO_ONLINE_TIMEOUT):
        res = []
        stime = time.time()
        Utilities.wait_for_ping(self.addr, self.DEF_BOOT_TIMEOUT)
        self.lgr.info("Device pings. Waiting for radio.")
        while time.time() <= stime + timeout:
            try:
                res = self.get_session().grep_remote_file(
                    self.RADIO_BOOT_LOG,
                    self.RADIO_ONLINE_STATUS_PATTERN,
                    timeout = timeout)
            except FileNotFoundError:
                time.sleep(self.WAIT_LOG_SLEEP)
            else:
                break
        if len(res) > 0:
            self.lgr.info("Radio is ready.")
            return True
        return False

    def _fetch_single_file_setting(self, setting):
        rfile = self.SINGLE_FILE_SETTINGS_MAP[setting]
        value = self.get_session().read_remote_file(rfile)[0].strip()
        if setting in ("bandwidth",):
            value = float(value) / 1e6 # Convert to MHz for these.
        return value

    def _push_single_file_setting(self, setting, value):
        rfile = self.SINGLE_FILE_SETTINGS_MAP[setting]
        if setting in ("bandwidth",):
            value *= 1e6  # Convert to Hz for these settings.
        outlines = (str(value),)
        self.get_session().write_remote_file(rfile, outlines, overwrite=True)

    def _fetch_radio_setup_script_settings(self):
        settings = {}
        scrset = {}
        for ln in self.get_session().read_remote_file(self.RADIO_SETUP_SCRIPT):
            m = re.search(self.RADIO_SETUP_SCRIPT_PATTERN, ln)
            if m:
                scrset[m[1]] = m[2]
        settings['fh_cplane_vlan'] = int(scrset['C0331'], base=16)
        settings['fh_uplane_vlan'] = int(scrset['C0318'], base=16)
        settings['du_cplane_mac'] = scrset['C031A'] + scrset['C0319']
        settings['du_uplane_mac'] = scrset['C0316'] + scrset['C0315']
        return settings

    def _push_radio_setup_script_settings(self, settings):
        outlines = []
        prepat = r'-w \1 -x 0x'
        subst = {
            'C0331': prepat +
            format(settings['fh_cplane_vlan'], 'X'),
            'C0318': prepat +
            format(settings['fh_uplane_vlan'], 'X'),
            'C0330': prepat +
            format(settings['fh_uplane_vlan'], 'X'),
            'C031A': prepat +
            settings['du_cplane_mac'][0:4].upper(),
            'C0319': prepat +
            settings['du_cplane_mac'][4:].upper(),
            'C0316': prepat +
            settings['du_uplane_mac'][0:4].upper(),
            'C0315': prepat +
            settings['du_uplane_mac'][4:].upper(),
        }
        for ln in self.get_session().read_remote_file(self.RADIO_SETUP_SCRIPT):
            ln = ln.rstrip()
            m = re.search(self.RADIO_SETUP_SCRIPT_PATTERN, ln)
            if m and m[1] in subst:
                res = re.sub(self.RADIO_SETUP_SCRIPT_PATTERN, subst[m[1]], ln)
                outlines.append(res)
            else:
                outlines.append(ln)
        outlines.append("") # Add final newline...
        self.get_session().\
            write_remote_file(self.RADIO_SETUP_SCRIPT, outlines, overwrite=True)

    def _fetch_radio_config_file_settings(self):
        settings = {}
        mapkeys = self.RADIO_CONFIG_FILE_MAP.keys()
        for ln in self.get_session().read_remote_file(self.RADIO_CONFIG_FILE):
            m = re.search(self.RADIO_CONFIG_FILE_PATTERN, ln)
            if m and m[1] in mapkeys:
                key, val = m[1], m[2]
                if key in ("centre_frequency_hz", "bandwidth_hz"):
                    val = float(val) / 1e6  # We handle these settings in MHz.
                elif key in ("c_plane_du_vlan", "u_plane_du_vlan_downlink",
                             "u_plane_du_vlan_downlink"):
                    val = int(val, base = 16) # Benetel keeps these in hex...
                elif key in ("c_plane_du_mac", "u_plane_du_mac"):
                    val = val.replace(":", "") # Emulab convention.
                settings[self.RADIO_CONFIG_FILE_MAP[key]] = val
        return settings

    def _push_radio_config_file_settings(self, settings):
        outlines = []
        mapkeys = self.RADIO_CONFIG_FILE_MAP.keys()
        for ln in self.get_session().read_remote_file(self.RADIO_CONFIG_FILE):
            ln = ln.rstrip()
            m = re.search(self.RADIO_CONFIG_FILE_PATTERN, ln)
            if m and m[1] in mapkeys:
                key = m[1]
                val = settings[self.RADIO_CONFIG_FILE_MAP[key]]
                if key in ("centre_frequency_hz", "bandwidth_hz"):
                    val = int(val*1e6)  # Convert these to Hz and round to int
                elif key in ("c_plane_du_vlan", "u_plane_du_vlan_downlink",
                             "u_plane_du_vlan_uplink"):
                    val = format(val, "x")  # Convert to hex for Benetel...
                elif key in ("c_plane_du_mac", "u_plane_du_mac"):
                    val = ":".join(re.findall("..", val)) # "Normal" mac string
                outlines.append(re.sub(self.RADIO_CONFIG_FILE_PATTERN,
                                       r'\1=' + str(val), ln))
            else:
                outlines.append(ln)
        outlines.append("") # Add final newline since this is a script...
        self.get_session().\
            write_remote_file(self.RADIO_CONFIG_FILE, outlines, overwrite=True)

    def fetch_settings(self):
        settings = self.DEVCONF_MAP[self._hardware]()
        if self._fwversion['major'] == 0 \
           or self._fwversion['major'] == 1 and self._fwversion['minor'] < 4:
            for stg in self.SINGLE_FILE_SETTINGS_MAP.keys():
                settings[stg] = self._fetch_single_file_setting(stg)
            settings.update(self._fetch_radio_setup_script_settings())
        settings.update(self._fetch_radio_config_file_settings())
        return settings

    def push_settings(self, settings):
        if not isinstance(settings, DeviceConfig):
            raise ValueError(f"{Utilities.whoami(self)}: 'settings' argument "
                             "must be a device configuration object instance!")
        if self._fwversion['major'] == 0 \
           or self._fwversion['major'] == 1 and self._fwversion['minor'] < 4:
            for stg in self.SINGLE_FILE_SETTINGS_MAP.keys():
                self._push_single_file_setting(stg, settings[stg])
            self._push_radio_setup_script_settings(settings)
        self._push_radio_config_file_settings(settings)
