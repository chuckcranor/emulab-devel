#!/usr/bin/env python

#
# This library contains the specific device proxy support for VVDN O-RU
# devices, for device configuration, status, and management.
#
# Note: Power control and reboot are handled by the standard testbed
#       `node_reboot` and `power` scripts. Modules specifically for
#       handling VVDN RUs should be present in these scripts. They use
#       this script to check device status and wait for initialization
#       to complete.

import logging
import re
import sys
import time
from lxml import objectify, etree
from ncclient import manager
from pyangbind.lib.serialise import pybindIETFXMLEncoder, pybindIETFXMLDecoder

sys.path.append("@prefix@/lib")
from libdevproxy import Utilities, DeviceConfig, DeviceWrapper
import libyb_ietf_interfaces
import libyb_oran_processing_element
import libyb_oran_uplane_conf

##############################################################################
#
# classes for individual M-Plane config elements
#
class MPlaneDefs(object):
    NS_DEFAULT = "urn:ietf:params:xml:ns:netconf:base:1.0"
    NS_PROCELT = "urn:o-ran:processing-element:1.0"
    NS_UPCONF  = "urn:o-ran:uplane-conf:1.0"
    NS_INTERFACES = "urn:ietf:params:xml:ns:yang:ietf-interfaces"
    NS_ORANIFACES = "urn:o-ran:interfaces:1.0"
    NS_IFTYPE = "urn:ietf:params:xml:ns:yang:iana-if-type"
    NS_IFIP = "urn:ietf:params:xml:ns:yang:ietf-ip"

# This function will only run once, no matter how many times this module
# is imported.
def _init_xml():
    if not hasattr(_init_xml, "has_run"):
        #etree.register_namespace(None, MPlaneDefs.NS_DEFAULT)
        etree.register_namespace('procelt', MPlaneDefs.NS_PROCELT)
        etree.register_namespace('upconf', MPlaneDefs.NS_UPCONF)
        etree.register_namespace('interfaces', MPlaneDefs.NS_INTERFACES)
        etree.register_namespace('ifref', MPlaneDefs.NS_ORANIFACES)
        etree.register_namespace('iftype', MPlaneDefs.NS_IFTYPE)
        etree.register_namespace('ifip', MPlaneDefs.NS_IFIP)
    _init_xml.has_run = True
#_init_xml()

# Abstract class for all MPlane configuration objects.
class MPlaneConfig(object):
    def __init__(self, xmlstr = None):
        if xmlstr is not None:
            dobj = objectify.fromstring(xmlstr)\
                            .find(f"{{{MPlaneDefs.NS_DEFAULT}}}data")
            root = objectify.Element("data")
            ifsobj = dobj.find(
                f"{{{MPlaneDefs.NS_INTERFACES}}}interfaces")
            root.append(ifsobj)
            self.yifsobj = pybindIETFXMLDecoder.load_xml(
                root, libyb_ietf_interfaces, "ietf-interfaces")
            root.remove(ifsobj)
            peobj = dobj.find(
                f"{{{MPlaneDefs.NS_PROCELT}}}processing-elements")
            root.append(peobj)
            self.ypeobj = pybindIETFXMLDecoder.load_xml(
                root, libyb_oran_processing_element, "o-ran-processing-element")
            root.remove(peobj)
            upobj = dobj.find(
                f"{{{MPlaneDefs.NS_UPCONF}}}user-plane-configuration")
            root.append(upobj)
            self.yupobj = pybindIETFXMLDecoder.load_xml(
                root, libyb_oran_uplane_conf, "o-ran-uplane-conf")
            root.remove(upobj)
        else:
            self.yifsobj = libyb_ietf_interfaces.ietf_interfaces()
            self.ypeobj  = libyb_oran_processing_element.o_ran_processing_element()
            self.yupobj  = libyb_oran_uplane_conf.o_ran_uplane_conf()

    #def pretty_print(self):
    #    print(etree.tostring(self.generate_xml(), encoding=str, pretty_print=True))

        
##############################################################################
#
# VVDN O-RU M-Plane session (over SSHWrapper connection)
#
class VVDNMPlaneSession(object):
    DEF_MPLANE_USER = DEF_MPLANE_PASS = "oranuser"
    DEF_LOG_LEVEL = logging.INFO
    DEF_PING_TIMEOUT = DeviceWrapper.DEF_PING_TIMEOUT

    def __init__(self, mgmt_addr, username=DEF_MPLANE_USER,
                 log_level = DEF_LOG_LEVEL):
        self.lgr = Utilities.mk_logger(self.__class__.__name__, log_level)
        self._addr = mgmt_addr
        self._user = username
        self._mgr = None
        self._connected = False
        self._config = None

    def connect_session(self, password=DEF_MPLANE_PASS,
                        ping_timeout=DEF_PING_TIMEOUT):
        Utilities.wait_for_ping(self._addr, ping_timeout)
        self._mgr = manager.connect_ssh(
            self._addr, username=self._user, password=password,
            hostkey_verify=False)
        self.lgr.info(f"M-Plane session established with {self._addr}, "
                      f"session ID {self._mgr.session_id}")
        self._connected = True

    def is_connected(self):
        return self._connected

    def get_session(self):
        if not self._mgr:
            self.connect_session()
        return self._mgr

    def get_config(self, source = "running", refresh = False):
        if refresh or self._config is None:
            self._config = self.get_session().get_config(source=source)
        return self._config

    def edit_config(self, config, target = "running"):
        return self.get_session().edit_config(target=target, config=config)


