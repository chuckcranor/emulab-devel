##############################################################################
#
# VVDNWrapper class definition
#
class VVDNWrapper(DeviceWrapper):
    DEF_LOG_LEVEL = logging.INFO
    DEF_USER = "oranuser"
    DEF_PASSWD = "oranuser"
    DEF_PING_TIMEOUT = 5
    DEF_BOOT_TIMEOUT = 120
    DEF_SHUTDOWN_TIME = 30
    DEF_RADIO_ONLINE_TIMEOUT = 300
    WAIT_LOG_SLEEP = 1
    FW_VERSION_UNKNOWN = "YYYYMMDDHHMMSS"
    FW_VERSION_FILE = "/etc/version"

    def __init__(self, mgmt_addr, username=DEF_USER, keyfile=None,
                 log_level = DEF_LOG_LEVEL):
        super().__init__(mgmt_addr, username, keyfile, log_level)
        self._mpsess = VVDNMPlaneSession(
            mgmt_addr, username, log_level=log_level)

    def connect_session(self, password = DEF_PASSWD, connect_ssh = False,
                        ping_timeout = DEF_PING_TIMEOUT):
        if connect_ssh:
            super().connect_session(password, ping_timeout)
        self._mpsess.connect_session(password, ping_timeout)

    def get_session(self):
        raise RuntimeError(
            f"{Utilities.whoami(self)}: Do not call this method! It is "
            "ambiguous in this class since multiple sessions exist.")

    def get_ssh_session(self):
        return super().get_session()

    def get_mplane_session(self):
        if not self._mpsess.is_connected():
            self.connect_session()
        return self._mpsess

    def fetch_settings(self):
        pass

    def push_settings(self):
        pass
