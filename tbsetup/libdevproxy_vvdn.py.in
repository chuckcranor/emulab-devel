#!/usr/bin/env python

#
# This library contains the specific device proxy support for VVDN O-RU
# devices, for device configuration, status, and management.
#
# Note: Power control and reboot are handled by the standard testbed
#       `node_reboot` and `power` scripts. Modules specifically for
#       handling VVDN RUs should be present in these scripts. They use
#       this script to check device status and wait for initialization
#       to complete.

import logging
import re
import sys
import time
from lxml import objectify, etree
from ncclient import manager
from ncclient.operations.rpc import RPCError
from pyangbind.lib.serialise import pybindIETFXMLEncoder, pybindIETFXMLDecoder

sys.path.append("@prefix@/lib")
from libdevproxy import Utilities, DeviceConfig, DeviceWrapper
import libyb_ietf_interfaces
import libyb_oran_processing_element
import libyb_oran_uplane_conf

##############################################################################
#
# Classes for M-Plane config handling
#
class MPlaneDefs(object):
    NS_DEFAULT = "urn:ietf:params:xml:ns:netconf:base:1.0"
    NS_PROCELT = "urn:o-ran:processing-element:1.0"
    NS_UPCONF  = "urn:o-ran:uplane-conf:1.0"
    NS_INTERFACES = "urn:ietf:params:xml:ns:yang:ietf-interfaces"
    NS_ORANIFACES = "urn:o-ran:interfaces:1.0"
    NS_IFTYPE = "urn:ietf:params:xml:ns:yang:iana-if-type"
    NS_IFIP = "urn:ietf:params:xml:ns:yang:ietf-ip"
    NS_HARDWARE = "urn:ietf:params:xml:ns:yang:ietf-hardware"
    NS_SYNC = "urn:o-ran:sync:1.0"

    IFTYPE_ETHERNET = "ethernetCsmacd"
    IFTYPE_L2VLAN = "l2vlan"

    DEF_PROCELT_TRANSPORT_SESSION_TYPE = "ETH-INTERFACE"

    ARRAY_CARRIER_INACTIVE = "INACTIVE"
    ARRAY_CARRIER_ACTIVE = "ACTIVE"

# Class for handling MPlane configuration parsing/generation.
class VVDNMPlaneConfig(object):
    DEF_RU_PROCESSING_ELEMENT = "element1"

    DEF_NUM_LLTX_LINKS = 4
    DEF_NUM_LLRX_LINKS = 4
    DEF_LLTX_LINK_PREFIX = "lltxlink"
    DEF_LLRX_LINK_PREFIX = "llrxlink"

    DEF_NUM_LLTX_ENDPOINTS = 4
    DEF_NUM_LLRX_ENDPOINTS = 8
    DEF_LLTX_ENDPOINT_PREFIX = "slltx-endpoint"
    DEF_LLRX_ENDPOINT_PREFIX = "sllrx-endpoint"
    DEF_COMMON_ENDPOINT_SETTINGS = {
        'compression': {
            'iq-bitwidth': 9,
            'compression-type': "STATIC",
            'fs-offset': 0,
        },
        'cp-length': 352,
        'cp-length-other': 288,
        'offset-to-absolute-frequency-center': 0,
        'number-of-prb-per-scs': [
            { 'scs': "KHZ_30", 'number-of-prb': 106, },
        ],
        'e-axcid': {
            'o-du-port-bitmask': 65024,
            'band-sector-bitmask': 448,
            'ccid-bitmask': 56,
            'ru-port-bitmask': 7,
        },
    }
    DEF_LLTX_ENDPOINT_SETTINGS = DEF_COMMON_ENDPOINT_SETTINGS | {}
    DEF_LLRX_ENDPOINT_SETTINGS = DEF_COMMON_ENDPOINT_SETTINGS | {
        'non-time-managed-delay-enabled': True,
        'ul-fft-sampling-offsets': [
            {'scs': "KHZ_30", 'ul-fft-sampling-offset': 0},
        ],
    }

    DEF_TX_ARRAY_CARRIER = "txarraycarrier0"
    DEF_RX_ARRAY_CARRIER = "rxarraycarrier0"
    DEF_COMMON_ARRAY_CARRIER_SETTINGS = {
        'absolute-frequency-center': 628000,
        'center-of-channel-bandwidth': 3420000000,
        'channel-bandwidth': 40000000,
        'active': MPlaneDefs.ARRAY_CARRIER_INACTIVE,
        'downlink-radio-frame-offset': 0,
        'downlink-sfn-offset': 0,
    }
    DEF_TX_ARRAY_CARRIER_SETTINGS = DEF_COMMON_ARRAY_CARRIER_SETTINGS | {
        'gain': 27,
    }
    DEF_RX_ARRAY_CARRIER_SETTINGS = DEF_COMMON_ARRAY_CARRIER_SETTINGS | {
        'gain-correction': 0.0,
        'n-ta-offset': 25600,
    }

    # These delete commands are a sort of "cheat" as they aren't
    # built up using proper lxml objects, but just trust that
    # it was a lot easier to do it this way.
    DEL_VLANIF_CMD = \
        """<interface xmlns="urn:ietf:params:xml:ns:yang:ietf-interfaces" xmlns:xc="urn:ietf:params:xml:ns:netconf:base:1.0" xc:operation="delete"><name>{}</name></interface>"""

    DEL_RUELT_CMD = \
        """<processing-elements xmlns="urn:o-ran:processing-element:1.0"><ru-elements xmlns:xc="urn:ietf:params:xml:ns:netconf:base:1.0" xc:operation="delete"><name>{}</name></ru-elements></processing-elements>"""

    DEL_LLTXEP_CMD = \
        """<low-level-tx-links xmlns="urn:o-ran:uplane-conf:1.0" xmlns:xc="urn:ietf:params:xml:ns:netconf:base:1.0" xc:operation="delete"><name>{}</name></low-level-tx-links>"""

    DEL_LLRXEP_CMD = \
        """<low-level-rx-links xmlns="urn:o-ran:uplane-conf:1.0" xmlns:xc="urn:ietf:params:xml:ns:netconf:base:1.0" xc:operation="delete"><name>{}</name></low-level-rx-links>"""

    def __init__(self, xmlstr = None):
        if xmlstr is not None:
            dobj = objectify.fromstring(xmlstr)\
                            .find(f"{{{MPlaneDefs.NS_DEFAULT}}}data")
            root = objectify.Element("data")
            ifsobj = dobj.find(
                f"{{{MPlaneDefs.NS_INTERFACES}}}interfaces")
            root.append(ifsobj)
            self.yifsobj = pybindIETFXMLDecoder.load_xml(
                root, libyb_ietf_interfaces,
                "ietf-interfaces").interfaces
            root.remove(ifsobj)
            peobj = dobj.find(f"{{{MPlaneDefs.NS_PROCELT}}}processing-elements")
            root.append(peobj)
            self.ypeobj = pybindIETFXMLDecoder.load_xml(
                root, libyb_oran_processing_element,
                "o-ran-processing-element").processing_elements
            root.remove(peobj)
            upobj = dobj.find(
                f"{{{MPlaneDefs.NS_UPCONF}}}user-plane-configuration")
            root.append(upobj)
            self.yupobj = pybindIETFXMLDecoder.load_xml(
                root, libyb_oran_uplane_conf,
                "o-ran-uplane-conf").user_plane_configuration
            root.remove(upobj)
        else:
            self.yifsobj = libyb_ietf_interfaces.\
                ietf_interfaces().interfaces
            self.ypeobj  = libyb_oran_processing_element.\
                o_ran_processing_element().processing_elements
            self.yupobj  = libyb_oran_uplane_conf.\
                o_ran_uplane_conf().user_plane_configuration

    def safe_name(self, name):
        return re.sub(r'-', '_', name)

    def get_interfaces(self):
        return self.yifsobj.interface.values()

    def find_interface(self, name = None, mac = None, vlan_id = 0):
        for intf in self.get_interfaces():
            if (name and intf.name == name) \
               or (mac and mac.lower() == intf.mac_address.lower() \
                   and vlan_id == intf.vlan_id):
                return intf
        return None

    def find_vlan_interfaces(self, basename = None, mac = None):
        rvals = []
        for intf in self.get_interfaces():
            if ((basename and basename == intf.base_interface) \
                or (mac and mac.lower() == intf.mac_address.lower()) \
                   and int(intf.vlan_id) != 0):
                rvals.append(intf)
        return rvals

    def mk_vlan_interface(self, vlan_id, basename = None, basemac = None):
        if vlan_id < 1 or vlan_id > 4094:
            raise ValueError(f"vlan_id out of range: {vlan_id}")
        baseif = self.find_interface(basename, basemac)
        vif = self.yifsobj.interface.add(f"{baseif.name}.{vlan_id}")
        vif.type = MPlaneDefs.IFTYPE_L2VLAN
        vif.enabled = True
        vif.base_interface = baseif.name
        vif.mac_address = baseif.mac_address
        vif.vlan_id = vlan_id
        vif.port_reference.port_name = baseif.port_reference.port_name
        vif.port_reference.port_number = baseif.port_reference.port_number
        return vif

    def delete_vlan_interface(self, name = None, mac = None, vlan_id = None):
        vif = self.find_interface(name, mac, vlan_id)
        delobj = objectify.fromstring(self.DEL_VLANIF_CMD.format(vif.name))
        self.yifsobj.interface.delete(vif.name)
        return delobj

    def get_ru_processing_elements(self):
        return self.ypeobj.ru_elements.values()

    def find_ru_processing_element(self, name = None, ifname = None, mac = None):
        for ruelt in self.get_ru_processing_elements():
            tf = ruelt.transport_flow
            if (name and ruelt.name == name) \
               or (ifname and tf.interface_name == ifname) \
               or (mac and tf.eth_flow.ru_mac_address.lower() == mac.lower()):
                return ruelt
        return None

    def mk_ru_processing_element(
            self, du_mac, name = DEF_RU_PROCESSING_ELEMENT,
            ifname = None, ru_mac = None, vlan_id = None
    ):
        ifobj = self.find_interface(ifname, ru_mac, vlan_id)
        self.ypeobj.transport_session_type = \
            MPlaneDefs.DEF_PROCELT_TRANSPORT_SESSION_TYPE
        tf = self.ypeobj.ru_elements.add(name).transport_flow
        tf.interface_name = ifobj.name
        tf.eth_flow.ru_mac_address = ifobj.mac_address
        tf.eth_flow.vlan_id = ifobj.vlan_id
        tf.eth_flow.o_du_mac_address = du_mac
        return self.ypeobj

    def delete_ru_processing_element(self, name = None, ifname = None, mac = None):
        ruelt = self.find_ru_processing_element(name, ifname, mac)
        delobj = objectify.fromstring(self.DEL_RUELT_CMD.format(ruelt.name))
        self.ypeobj.ru_elements.delete(ruelt.name)
        return delobj

    def find_uplane_lltx_links(self, prefix = None, pename = None):
        rvals = []
        for lltxlink in self.yupobj.low_level_tx_links.values():
            if (prefix and prefix in lltxlink.name) \
               or (pename and pename == lltxlink.processing_element):
                rvals.append(lltxlink)
        return rvals

    def mk_uplane_lltx_links(
            self, link_prefix = DEF_LLTX_LINK_PREFIX,
            endpoint_prefix = DEF_LLTX_ENDPOINT_PREFIX,
            processing_element = DEF_RU_PROCESSING_ELEMENT,
            tx_array_carrier = DEF_TX_ARRAY_CARRIER,
            count = DEF_NUM_LLTX_LINKS
    ):
        rvals = []
        for i in range(count):
            lltxlink = self.yupobj.low_level_tx_links.add(f"{link_prefix}{i}")
            lltxlink.low_level_tx_endpoint = f"{endpoint_prefix}{i}"
            lltxlink.processing_element = processing_element
            lltxlink.tx_array_carrier = tx_array_carrier
            rvals.append(lltxlink)
        return rvals

    def delete_uplane_lltx_links(self, prefix = None, pename = None):
        delcmds = []
        for lltxelt in self.find_uplane_lltx_links(prefix, pename):
            delcmds.append(objectify.fromstring(self.DEL_LLTXEP_CMD.format(lltxelt.name)))
            self.yupobj.low_level_tx_links.delete(lltxelt.name)
        return delcmds

    def find_uplane_llrx_links(self, prefix = None, pename = None):
        rvals = []
        for llrxlink in self.yupobj.low_level_rx_links.values():
            if (prefix and prefix in llrxlink.name) \
               or (pename and pename == llrxlink.processing_element):
                rvals.append(llrxlink)
        return rvals

    def mk_uplane_llrx_links(
            self, link_prefix = DEF_LLRX_LINK_PREFIX,
            endpoint_prefix = DEF_LLRX_ENDPOINT_PREFIX,
            processing_element = DEF_RU_PROCESSING_ELEMENT,
            rx_array_carrier = DEF_RX_ARRAY_CARRIER,
            count = DEF_NUM_LLRX_LINKS
    ):
        rvals = []
        for i in range(count):
            llrxlink = self.yupobj.low_level_rx_links.add(f"{link_prefix}{i}")
            llrxlink.low_level_rx_endpoint = f"{endpoint_prefix}{i}"
            llrxlink.processing_element = processing_element
            llrxlink.rx_array_carrier = rx_array_carrier
            rvals.append(llrxlink)
        return rvals

    def delete_uplane_llrx_links(self, prefix = None, pename = None):
        delcmds = []
        for llrxelt in self.find_uplane_llrx_links(prefix, pename):
            delcmds.append(objectify.fromstring(self.DEL_LLRXEP_CMD.format(llrxelt.name)))
            self.yupobj.low_level_rx_links.delete(llrxelt.name)
        return delcmds

    def get_uplane_lltx_endpoint(self, name):
        return self.yupobj.low_level_tx_endpoints[name]

    def find_uplane_lltx_endpoints(self, prefix):
        rvals = []
        for ep in self.yupobj.low_level_tx_endpoints.values():
            if prefix in ep.name:
                rvals.append(ep)
        return rvals

    def _mk_uplane_endpoints(self, endpoints_obj, endpoint_prefix, settings,
                             count):
        for i in range(count):
            llep = endpoints_obj.add(f"{endpoint_prefix}{i}")
            for k, v in settings.items():
                if type(v) == dict:
                    sdict = getattr(llep, self.safe_name(k))
                    for j, u in v.items():
                        setattr(sdict, self.safe_name(j), u)
                elif type(v) == list:
                    slist = getattr(llep, self.safe_name(k))
                    for e in v:
                        nkey = 'name'
                        if 'scs' in e:
                            nkey = 'scs'
                        name = e[nkey]
                        if name not in slist.keys():
                            slist.add(name)
                        for j, u in e.items():
                            if j == nkey: continue
                            setattr(slist[name], self.safe_name(j), u)
                else:
                    setattr(llep, self.safe_name(k), v)
            llep.e_axcid.eaxc_id = i

    def mk_uplane_lltx_endpoints(
            self,
            endpoint_prefix = DEF_LLTX_ENDPOINT_PREFIX,
            settings = DEF_LLTX_ENDPOINT_SETTINGS,
            count = DEF_NUM_LLTX_ENDPOINTS
    ):
        lltxeps_obj = self.yupobj.low_level_tx_endpoints
        self._mk_uplane_endpoints(lltxeps_obj, endpoint_prefix, settings, count)
        return lltxeps_obj

    def get_uplane_llrx_endpoint(self, name):
        return self.yupobj.low_level_rx_endpoints[name]

    def find_uplane_llrx_endpoints(self, prefix):
        rvals = []
        for ep in self.yupobj.low_level_rx_endpoints.values():
            if prefix in ep.name:
                rvals.append(ep)
        return rvals

    def mk_uplane_llrx_endpoints(
            self,
            endpoint_prefix = DEF_LLRX_ENDPOINT_PREFIX,
            settings = DEF_LLRX_ENDPOINT_SETTINGS,
            count = DEF_NUM_LLRX_ENDPOINTS
    ):
        llrxeps_obj = self.yupobj.low_level_rx_endpoints
        self._mk_uplane_endpoints(llrxeps_obj, endpoint_prefix, settings, count)
        return llrxeps_obj

    def get_uplane_tx_array_carrier(self, name):
        return self.yupobj.tx_array_carriers[name]

    def mk_uplane_tx_array_carrier(
            self, name = DEF_TX_ARRAY_CARRIER,
            settings = DEF_TX_ARRAY_CARRIER_SETTINGS
    ):
        txcarr = self.yupobj.tx_array_carriers.add(name)
        for k, v in settings.items():
            setattr(txcarr, self.safe_name(k), v)
        return txcarr

    def get_uplane_rx_array_carrier(self, name):
        return self.yupobj.rx_array_carriers[name]

    def mk_uplane_rx_array_carrier(
            self, name = DEF_RX_ARRAY_CARRIER,
            settings = DEF_RX_ARRAY_CARRIER_SETTINGS
    ):
        rxcarr = self.yupobj.rx_array_carriers.add(name)
        for k, v in settings.items():
            setattr(rxcarr, self.safe_name(k), v)
        return rxcarr


##############################################################################
#
# VVDN O-RU M-Plane session (over SSHWrapper connection)
#
class VVDNMPlaneSession(object):
    DEF_MPLANE_USER = DEF_MPLANE_PASS = "oranuser"
    DEF_LOG_LEVEL = logging.INFO
    DEF_PING_TIMEOUT = DeviceWrapper.DEF_PING_TIMEOUT

    def __init__(self, mgmt_addr, username=DEF_MPLANE_USER,
                 log_level = DEF_LOG_LEVEL):
        self.lgr = Utilities.mk_logger(self.__class__.__name__, log_level)
        self._addr = mgmt_addr
        self._user = username
        self._pass = self.DEF_MPLANE_PASS
        self._mgr = None
        self._config = None

    def connect_session(self, password=DEF_MPLANE_PASS,
                        ping_timeout=DEF_PING_TIMEOUT):
        if ping_timeout:
            Utilities.wait_for_ping(self._addr, ping_timeout)
        self._mgr = manager.connect_ssh(
            self._addr, username=self._user, password=password,
            hostkey_verify=False)
        self._pass = password

    def is_connected(self):
        return self._mgr and self._mgr.connected

    def get_session(self):
        if not self.is_connected():
            self.connect_session(self._pass)
        return self._mgr

    def close_session(self):
        if self.is_connected():
            self._mgr.close_session()
        self._mgr = None

    def get(self, infilt):
        return self.get_session().get(("subtree", infilt))

    def get_config(self, source = "running", refresh = False):
        if refresh or self._config is None:
            self._config = self.get_session().get_config(source=source)
        return self._config

    def edit_config(self, config, target = "running"):
        rval = None
        try:
            rval = self.get_session().edit_config(target=target, config=config)
        except RPCError:
            self.lgr.error(f"edit_config operation failed on {self._addr}:\n{config}")
            raise
        return rval

    # Not currently supported by VVDN devices :facepalm:
    def reboot(self):
        self.get_session().reboot_machine()

    def save_config(self):
        self.get_session().copy_config("running", "startup")

##############################################################################
#
# VVDNConfig class definitions. Defines configuration settings and defaults.
#
class VVDNConfig_MPRU_b78(DeviceConfig):
    DEFAULT_SETTINGS = {
        'center_frequency': {
            'def': 3420.0,
            'allowed_ranges': ((3400.0,3700.0),)
        },
        'bandwidth': {
            'def': 40.0,
            'allowed_values': (10.0, 20.0, 40.0, 60.0, 80.0, 100.0)
        },
        'gain': {
            'def': 37.0,
            'allowed_ranges': ((1.0,37.0),)
        },
        'ofh_vlan': {
            'def': 1,
            'allowed_ranges': ((1,4096),)
        },
        'ru_mac': {
            'def': '000000000000',
            'allowed_patterns': (r'[0-9A-Fa-f]{12}',)
        },
        'du_mac': {
            'def': '000000000000',
            'allowed_patterns': (r'[0-9A-Fa-f]{12}',)
        },
        'mimo_mode': {
            'def': '1_2_3_4_4x4',
            'allowed_values': ('1_3','2_4','1_2_3_4_4x2','1_2_3_4_4x4')
        },
        'compression': {
            'def': 'dynamic_compressed',
            'allowed_values': ('static_uncompressed', 'static_compressed',
                               'dynamic_uncompressed', 'dynamic_compressed')
        },
    }

##############################################################################
#
# Top-level VVDNWrapper class definition
#
class VVDNWrapper(DeviceWrapper):
    DEF_LOG_LEVEL = logging.INFO
    DEF_USER = "oranuser"
    DEF_PASSWD = "oranuser"
    DEF_PING_TIMEOUT = 5
    DEF_BOOT_TIMEOUT = 120
    DEF_SHUTDOWN_TIME = 30
    DEF_RADIO_ONLINE_TIMEOUT = 180
    DEF_SSH_RETRIES = 6
    WAIT_ONLINE_SLEEP = 3
    FW_VERSION_UNKNOWN = "NN-vX.Y.Z.R"
    REBOOT_CMD = "/sbin/reboot"
    PRACH_SET_COMPRESSION_CMD = "/usr/bin/mw.l a0010024 1919"

    BW2PRB_MAP_30KHZ = {
        10000000:  24,
        20000000:  51,
        40000000:  106,
        60000000:  162,
        80000000:  217,
        100000000: 273
    }

    def __init__(self, mgmt_addr, username=DEF_USER, keyfile=None,
                 log_level = DEF_LOG_LEVEL):
        super().__init__(mgmt_addr, username, keyfile, log_level)
        self._mpsess = VVDNMPlaneSession(
            mgmt_addr, username, log_level=log_level)
        self._fwversion = self.FW_VERSION_UNKNOWN
        self._mpconf = None

    def connect_session(self, password = DEF_PASSWD,
                        ping_timeout = DEF_PING_TIMEOUT,
                        retries = DEF_SSH_RETRIES):
        self.connect_ssh_session(password, ping_timeout, retries)
        self.connect_mplane_session(password, ping_timeout = 0)

    def connect_ssh_session(self, password = DEF_PASSWD,
                            ping_timeout = DEF_PING_TIMEOUT,
                            retries = DEF_SSH_RETRIES):
        super().connect_session(password, ping_timeout, retries)

    def connect_mplane_session(self, password = DEF_PASSWD,
                               ping_timeout = DEF_PING_TIMEOUT):
        self._mpsess.connect_session(password, ping_timeout)
        self._mpconf = VVDNMPlaneConfig(str(self._mpsess.get_config()))
        self._mk_missing_uplane_settings()
        self._fetch_fwinfo()

    def get_ssh_session(self):
        return super().get_session()

    def get_mplane_session(self):
        if not self._mpsess.is_connected():
            self.connect_mplane_session(self._pass)
        return self._mpsess

    def close_session(self):
        self.close_ssh_session()
        self.close_mplane_session()

    def close_ssh_session(self):
        super().close_session()

    def close_mplane_session(self):
        self._mpsess.close_session()

    def wait_for_radio_online(self, timeout = DEF_RADIO_ONLINE_TIMEOUT):
        filt = etree.Element("sync", nsmap={None: MPlaneDefs.NS_SYNC})
        etree.SubElement(etree.SubElement(filt, "sync-status"), "sync-state")
        stime = time.time()
        while time.time() <= stime + timeout:
            res = self.get_mplane_session().get(filt)
            if res:
                sstate = res.data.xpath("//*[local-name()='sync-state']")
                if len(sstate) > 0:
                    sval = sstate[0].text
                    self.lgr.info(f"Radio sync state: {sval}")
                    if sval.lower() == "locked":
                        self.lgr.info("Radio is ready.")
                        return True
            time.sleep(self.WAIT_ONLINE_SLEEP)
        return False

    def _set_carrier_state(self, state):
        conf = VVDNMPlaneConfig()
        confelt = etree.Element(f"config", nsmap={None: MPlaneDefs.NS_DEFAULT})
        settings = { "active": state }
        conf.mk_uplane_tx_array_carrier(settings = settings)
        conf.mk_uplane_rx_array_carrier(settings = settings)
        confelt.append(pybindIETFXMLEncoder.encode(conf.yupobj))
        self._mpsess.edit_config(
            etree.tostring(confelt, encoding=str, pretty_print=True))

    def activate_carrier(self):
        # Hack: First push the PRACH compression settings via SSH before
        # activating the carriers (VVDN derp!). These settings are lost
        # when VVDN RUs are rebooted or power cycled.
        stdout, stderr = self.get_ssh_session().\
            exec(self.PRACH_SET_COMPRESSION_CMD)
        if stderr:
            raise RuntimeError(
                f"Failed to set PRACH compression settings:\n{''.join(stderr)}")
        self._set_carrier_state(MPlaneDefs.ARRAY_CARRIER_ACTIVE)

    def deactivate_carrier(self):
        self._set_carrier_state(MPlaneDefs.ARRAY_CARRIER_INACTIVE)

    def _fetch_fwinfo(self):
        filt = etree.Element("hardware", nsmap={None: MPlaneDefs.NS_HARDWARE})
        etree.SubElement(etree.SubElement(filt, "component"), "software-rev")
        res = self.get_mplane_session().get(filt)
        if res:
            self._fwversion = \
                res.data.xpath("//*[local-name()='software-rev']")[0].text

    def _get_active_vif(self):
        vif = None
        ruelt = self._mpconf.find_ru_processing_element(
            VVDNMPlaneConfig.DEF_RU_PROCESSING_ELEMENT)
        if ruelt:
            vif = self._mpconf.find_interface(
                ruelt.transport_flow.interface_name)
        return vif

    def _mk_missing_uplane_settings(self):
        upcelt = etree.Element("user-plane-configuration",
                               nsmap={None: MPlaneDefs.NS_UPCONF})
        try:
            self._mpconf.get_uplane_tx_array_carrier(
                VVDNMPlaneConfig.DEF_TX_ARRAY_CARRIER)
        except KeyError:
            newtxcarr = self._mpconf.mk_uplane_tx_array_carrier()
            upcelt.append(pybindIETFXMLEncoder.encode(newtxcarr))
        try:
            self._mpconf.get_uplane_rx_array_carrier(
                VVDNMPlaneConfig.DEF_RX_ARRAY_CARRIER)
        except KeyError:
            newtxcarr = self._mpconf.mk_uplane_rx_array_carrier()
            upcelt.append(pybindIETFXMLEncoder.encode(newrxcarr))
        try:
            self._mpconf.get_uplane_lltx_endpoint(
                f"{VVDNMPlaneConfig.DEF_LLTX_ENDPOINT_PREFIX}0")
        except KeyError:
            for lltxep in self._mpconf.mk_uplane_lltx_endpoints():
                upcelt.append(pybindIETFXMLEncoder.encode(lltxep))
        try:
            self._mpconf.get_uplane_llrx_endpoint(
                f"{VVDNMPlaneConfig.DEF_LLRX_ENDPOINT_PREFIX}0")
        except KeyError:
            for llrxep in self._mpconf.mk_uplane_llrx_endpoints():
                upcelt.append(pybindIETFXMLEncoder.encode(llrxep))
        if len(upcelt.getchildren()) > 0:
            self.lgr.info(f"Pushing missing uplane settings to {self.addr}")
            self._push_settings_groups([[upcelt,],])
            
    def _mk_active_vif(self, settings):
        mk_cmds = []
        rumac = Utilities.elab2std_mac(settings['ru_mac'])
        dumac = Utilities.elab2std_mac(settings['du_mac'])
        ifelt = etree.Element("interfaces",
                              nsmap={None: MPlaneDefs.NS_INTERFACES})
        newvif = self._mpconf.mk_vlan_interface(
            settings['ofh_vlan'], basemac=rumac)
        ifelt.append(pybindIETFXMLEncoder.encode(newvif))
        mk_cmds.append(ifelt)
        newruelt = self._mpconf.mk_ru_processing_element(
            dumac, ru_mac=rumac, vlan_id=settings["ofh_vlan"])
        mk_cmds.append(pybindIETFXMLEncoder.encode(newruelt))
        upcelt = etree.Element("user-plane-configuration",
                               nsmap={None: MPlaneDefs.NS_UPCONF})
        for lltxlink in self._mpconf.mk_uplane_lltx_links():
            upcelt.append(pybindIETFXMLEncoder.encode(lltxlink))
        for llrxlink in self._mpconf.mk_uplane_llrx_links():
            upcelt.append(pybindIETFXMLEncoder.encode(llrxlink))
        mk_cmds.append(upcelt)
        return mk_cmds

    def _delete_active_vif(self, active_vif):
        vifrm_cmds = []
        ifrelt  = etree.Element("interfaces",
                                nsmap={None: MPlaneDefs.NS_INTERFACES})
        upcelt = etree.Element("user-plane-configuration",
                                nsmap={None: MPlaneDefs.NS_UPCONF})
        for rm_cmd in self._mpconf.delete_uplane_lltx_links(
                pename=VVDNMPlaneConfig.DEF_RU_PROCESSING_ELEMENT):
            upcelt.append(rm_cmd)
        for rm_cmd in self._mpconf.delete_uplane_llrx_links(
                pename=VVDNMPlaneConfig.DEF_RU_PROCESSING_ELEMENT):
            upcelt.append(rm_cmd)
        vifrm_cmds.append(upcelt)
        vifrm_cmds.append(self._mpconf.delete_ru_processing_element(
            VVDNMPlaneConfig.DEF_RU_PROCESSING_ELEMENT))
        ifrelt.append(self._mpconf.delete_vlan_interface(active_vif.name))
        vifrm_cmds.append(ifrelt)
        return vifrm_cmds

    def _push_settings_groups(self, groups):
        confelt = etree.Element(
            f"config",
            nsmap={None: MPlaneDefs.NS_DEFAULT, 'xc': MPlaneDefs.NS_DEFAULT})
        self.deactivate_carrier()
        for group in groups:
            if group:
                for cmd in group:
                    confelt.append(cmd)
                self.get_mplane_session().edit_config(
                    etree.tostring(confelt, encoding=str, pretty_print=True))
                confelt.clear()
        # Note: caller must separately (re)activate the radio carrier!

    def fetch_settings(self):
        settings = VVDNConfig_MPRU_b78()
        txcarr = self._mpconf.get_uplane_tx_array_carrier(
            VVDNMPlaneConfig.DEF_TX_ARRAY_CARRIER)
        ethflow = self._mpconf.find_ru_processing_element(
            VVDNMPlaneConfig.DEF_RU_PROCESSING_ELEMENT).transport_flow.eth_flow
        txep = self._mpconf.get_uplane_lltx_endpoint(
            f"{VVDNMPlaneConfig.DEF_LLTX_ENDPOINT_PREFIX}0")
        settings['center_frequency'] = txcarr.center_of_channel_bandwidth / 1e6
        settings['bandwidth'] = txcarr.channel_bandwidth / 1e6
        settings['gain'] = txcarr.gain
        settings['ofh_vlan'] = ethflow.vlan_id
        settings['ru_mac'] = Utilities.std2elab_mac(ethflow.ru_mac_address)
        settings['du_mac'] = Utilities.std2elab_mac(ethflow.o_du_mac_address)
        cmpmeth = 'uncompressed' \
            if txep.compression.compression_method == 'NO_COMPRESSION' \
               else 'compressed'
        settings['compression'] = \
            f"{txep.compression.compression_type.lower()}_{cmpmeth}"
        return settings

    def push_settings(self, settings):
        vifrm_cmds = []
        vifmk_cmds = []
        upc_cmds = []

        # First handle any necessary (re)creation/cleanup related to the
        # OFH vlan interface.
        ifrelt  = etree.Element("interfaces",
                                nsmap={None: MPlaneDefs.NS_INTERFACES})
        active_vif = self._get_active_vif()
        if active_vif:
            if active_vif.vlan_id != settings["ofh_vlan"]:
                vifrm_cmds = self._delete_active_vif(active_vif)
                vifmk_cmds = self._mk_active_vif(settings)
        else:
            baseif = self._mpconf.find_interface(mac=settings["ru_mac"])
            for vif in self._mpconf.find_vlan_interfaces(baseif.name):
                ifrelt.append(self._mpconf.delete_vlan_interface(vif.name))
            vifrm_cmds.append(ifrelt)
            vifmk_cmds = self._mk_active_vif(settings)

        # Now deal with changes to the "user plane configuration"
        upcelt = etree.Element("user-plane-configuration",
                               nsmap={None: MPlaneDefs.NS_UPCONF})
        txcarr = self._mpconf.get_uplane_tx_array_carrier(
            VVDNMPlaneConfig.DEF_TX_ARRAY_CARRIER)
        rxcarr = self._mpconf.get_uplane_rx_array_carrier(
            VVDNMPlaneConfig.DEF_RX_ARRAY_CARRIER)
        txcarr.active = rxcarr.active = MPlaneDefs.ARRAY_CARRIER_INACTIVE
        txcarr.center_of_channel_bandwidth = \
            rxcarr.center_of_channel_bandwidth = \
                int(settings["center_frequency"] * 1e6)
        txcarr.absolute_frequency_center = \
            rxcarr.absolute_frequency_center = \
                Utilities.cf2arfcn(settings["center_frequency"])
        newbw = int(settings['bandwidth'] * 1e6)
        if newbw != txcarr.channel_bandwidth:
            newprb = self.BW2PRB_MAP_30KHZ[newbw]
            for txep in self._mpconf.find_uplane_lltx_endpoints(
                    prefix=VVDNMPlaneConfig.DEF_LLTX_ENDPOINT_PREFIX):
                txep.number_of_prb_per_scs["KHZ_30"].number_of_prb = newprb
                upcelt.append(pybindIETFXMLEncoder.encode(txep))
            for rxep in self._mpconf.find_uplane_llrx_endpoints(
                    prefix=VVDNMPlaneConfig.DEF_LLRX_ENDPOINT_PREFIX):
                rxep.number_of_prb_per_scs["KHZ_30"].number_of_prb = newprb
                upcelt.append(pybindIETFXMLEncoder.encode(rxep))
        txcarr.channel_bandwidth = rxcarr.channel_bandwidth = newbw
        txcarr.gain = settings["gain"]
        upcelt.append(pybindIETFXMLEncoder.encode(txcarr))
        upcelt.append(pybindIETFXMLEncoder.encode(rxcarr))
        upc_cmds.append(upcelt)
        self._push_settings_groups([vifrm_cmds, vifmk_cmds, upc_cmds])
        self.get_mplane_session().save_config()
