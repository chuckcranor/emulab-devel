#!/usr/bin/env python

#
# This library contains the specific device proxy support for VVDN O-RU
# devices, for device configuration, status, and management.
#
# Note: Power control and reboot are handled by the standard testbed
#       `node_reboot` and `power` scripts. Modules specifically for
#       handling VVDN RUs should be present in these scripts. They use
#       this script to check device status and wait for initialization
#       to complete.

import logging
import re
import sys
import time
from lxml import objectify, etree
from ncclient import manager
from pyangbind.lib.serialise import pybindIETFXMLEncoder, pybindIETFXMLDecoder

sys.path.append("@prefix@/lib")
from libdevproxy import Utilities, DeviceConfig, DeviceWrapper
import libyb_ietf_interfaces
import libyb_oran_processing_element
import libyb_oran_uplane_conf

##############################################################################
#
# classes for individual M-Plane config elements
#
class MPlaneDefs(object):
    NS_DEFAULT = "urn:ietf:params:xml:ns:netconf:base:1.0"
    NS_PROCELT = "urn:o-ran:processing-element:1.0"
    NS_UPCONF  = "urn:o-ran:uplane-conf:1.0"
    NS_INTERFACES = "urn:ietf:params:xml:ns:yang:ietf-interfaces"
    NS_ORANIFACES = "urn:o-ran:interfaces:1.0"
    NS_IFTYPE = "urn:ietf:params:xml:ns:yang:iana-if-type"
    NS_IFIP = "urn:ietf:params:xml:ns:yang:ietf-ip"

# This function will only run once, no matter how many times this module
# is imported.
def _init_xml():
    if not hasattr(_init_xml, "has_run"):
        #etree.register_namespace(None, MPlaneDefs.NS_DEFAULT)
        etree.register_namespace('procelt', MPlaneDefs.NS_PROCELT)
        etree.register_namespace('upconf', MPlaneDefs.NS_UPCONF)
        etree.register_namespace('interfaces', MPlaneDefs.NS_INTERFACES)
        etree.register_namespace('ifref', MPlaneDefs.NS_ORANIFACES)
        etree.register_namespace('iftype', MPlaneDefs.NS_IFTYPE)
        etree.register_namespace('ifip', MPlaneDefs.NS_IFIP)
    _init_xml.has_run = True
#_init_xml()

# Abstract class for all MPlane configuration objects.
class MPlaneConfig(object):
    IFTYPE_ETHERNET = "ethernetCsmacd"
    IFTYPE_L2VLAN = "l2vlan"
    
    DEF_RU_PROCESSING_ELEMENT = "element1"
    DEF_PROCELT_TRANSPORT_SESSION_TYPE = "ETH-INTERFACE"

    DEF_LLTX_LINK_PREFIX = "lltxlink"
    DEF_LLRX_LINK_PREFIX = "llrxlink"

    DEF_LLTX_ENDPOINT_PREFIX = "slltx-endpoint"
    DEF_LLRX_ENDPOINT_PREFIX = "sllrx-endpoint"
    DEF_LLRX_ENDPOINT_NON_TIME_MANAGED_DELAY_ENABLED = True
    DEF_LLEP_COMPRESSION_IQ_BITWIDTH = 9
    DEF_LLEP_COMPRESSION_TYPE = "STATIC"
    DEF_LLEP_COMPRESSION_FS_OFFSET = 0
    DEF_LLEP_CP_LENGTH = 352
    DEF_LLEP_CP_LENGTH_OTHER = 288
    DEF_LLEP_ABS_CF_OFFSET = 0
    DEF_LLEP_NUM_PRB_PER_SCS_ENTRIES = [
        {"scs": "KHZ_30", "number-of-prb": 106},
    ]
    DEF_LLEP_EAXCID_ATTRS = {
        "o-du-port-bitmask": 65024,
        "band-sector-bitmask": 448,
        "ccid-bitmask": 56,
        "ru-port-bitmask": 7,
    }

    DEF_TX_ARRAY_CARRIER = "txarraycarrier0"
    DEF_RX_ARRAY_CARRIER = "rxarraycarrier0"
    DEF_TX_ARRAY_CARRIER_GAIN = 27.0
    DEF_RX_ARRAY_CARRIER_GAIN_CORRECTION = 0.0
    DEF_RX_ARRAY_CARRIER_N_TA_OFFSET = 25600
    DEF_ARRAY_CARRIER_DL_RADIO_FRAME_OFFSET = 0
    DEF_ARRAY_CARRIER_DL_SFN_OFFSET = 0

    NUM_LLTX_LINKS = 4
    NUM_LLTX_ENDPOINTS = 4
    NUM_LLRX_LINKS = 4
    NUM_LLRX_ENDPOINTS = 8

    ARRAY_CARRIER_INACTIVE = "INACTIVE"
    ARRAY_CARRIER_ACTIVE = "ACTIVE"

    DEL_VLANIF_CMD = """
    <interfaces xmlns="urn:ietf:params:xml:ns:yang:ietf-interfaces">
      <interface xmlns:xc="urn:ietf:params:xml:ns:netconf:base:1.0" xc:operation="delete">
        <name>{}</name>
      </interface>
    </interfaces>
    """

    DEL_RUELT_CMD = """
    <processing-elements xmlns="urn:o-ran:processing-element:1.0">
      <ru-elements xmlns:xc="urn:ietf:params:xml:ns:netconf:base:1.0" xc:operation="delete">
        <name>{}</name>
      </ru-elements>
    </processing-elements>
    """

    def __init__(self, xmlstr = None):
        if xmlstr is not None:
            dobj = objectify.fromstring(xmlstr)\
                            .find(f"{{{MPlaneDefs.NS_DEFAULT}}}data")
            root = objectify.Element("data")
            ifsobj = dobj.find(
                f"{{{MPlaneDefs.NS_INTERFACES}}}interfaces")
            root.append(ifsobj)
            self.yifsobj = pybindIETFXMLDecoder.load_xml(
                root, libyb_ietf_interfaces, "ietf-interfaces")
            root.remove(ifsobj)
            peobj = dobj.find(
                f"{{{MPlaneDefs.NS_PROCELT}}}processing-elements")
            root.append(peobj)
            self.ypeobj = pybindIETFXMLDecoder.load_xml(
                root, libyb_oran_processing_element, "o-ran-processing-element")
            root.remove(peobj)
            upobj = dobj.find(
                f"{{{MPlaneDefs.NS_UPCONF}}}user-plane-configuration")
            root.append(upobj)
            self.yupobj = pybindIETFXMLDecoder.load_xml(
                root, libyb_oran_uplane_conf, "o-ran-uplane-conf")
            root.remove(upobj)
        else:
            self.yifsobj = libyb_ietf_interfaces.ietf_interfaces()
            self.ypeobj  = libyb_oran_processing_element.\
                o_ran_processing_element()
            self.yupobj  = libyb_oran_uplane_conf.o_ran_uplane_conf()

    def safe_name(self, name):
        return re.sub(r'-', '_', name)

    def get_interfaces(self):
        return self.yifsobj.interfaces.interface.values()

    def get_vlan_interfaces(self, mac = None):
        rvals = []
        for intf in self.get_interfaces():
            if (not mac or mac.lower() == intf.mac_address.lower()) \
               and int(intf.vlan_id) != 0:
                rvals.append(intf)
        return rvals

    def find_interface(self, name = None, mac = None, vlan_id = 0):
        for intf in self.get_interfaces():
            if (name and intf.name == name) \
               or (mac and mac.lower() == intf.mac_address.lower() \
                   and vlan_id == intf.vlan_id):
                return intf
        return None

    def mk_vlan_interface(self, vlan_id, basename = None, basemac = None):
        if vlan_id < 1 or vlan_id > 4094:
            raise ValueError(f"vlan_id out of range: {vlan_id}")
        baseif = self.find_interface(basename, basemac)
        vif = self.yifsobj.interfaces.interface.add(f"{baseif.name}.{vlan_id}")
        vif.type = self.IFTYPE_L2VLAN
        vif.enabled = True
        vif.base_interface = baseif.name
        vif.mac_address = baseif.mac_address
        vif.vlan_id = vlan_id
        vif.port_reference.port_name = baseif.port_reference.port_name
        vif.port_reference.port_number = baseif.port_reference.port_number
        return vif

    def delete_vlan_interface(self, name = None, mac = None, vlan_id = None):
        vif = self.find_interface(name, mac, vlan_id)
        cmd = self.DEL_VLANIF_CMD.format(vif.name)
        self.yifsobj.interfaces.interface.delete(vif.name)
        return cmd

    def get_ru_processing_elements(self):
        return self.ypeobj.processing_elements.ru_elements.values()

    def find_ru_processing_element(self, name = None, ifname = None, mac = None):
        for ruelt in self.get_ru_processing_elements():
            tf = ruelt.transport_flow
            if (name and ruelt.name == name) \
               or (ifname and tf.interface_name.lower() == ifname.lower()) \
               or (mac and tf.eth_flow.ru_mac_address.lower() == mac.lower()):
                return ruelt
        return None

    def mk_ru_processing_element(
            self, du_mac, name = DEF_RU_PROCESSING_ELEMENT,
            ifname = None, mac = None, vlan_id = None
    ):
        ifobj = self.find_interface(ifname, mac, vlan_id)
        self.ypeobj.processing_elements.transport_session_type = \
            self.DEF_PROCELT_TRANSPORT_SESSION_TYPE
        ruelt = self.ypeobj.processing_elements.ru_elements.add(name)
        tf = ruelt.transport_flow
        tf.interface_name = ifobj.name
        tf.eth_flow.ru_mac_address = ifobj.mac_address
        tf.eth_flow.vlan_id = ifobj.vlan_id
        tf.eth_flow.o_du_mac_address = du_mac
        return ruelt

    def delete_ru_processing_element(self, name = None, ifname = None, mac = None):
        ruelt = self.find_ru_processing_element(name, ifname, mac)
        cmd = self.DEL_RUELT_CMD.format(ruelt.name)
        self.ypeobj.processing_elements.ru_elements.delete(ruelt.name)
        return cmd

    def mk_uplane_lltx_links(
            self, link_prefix = DEF_LLTX_LINK_PREFIX,
            endpoint_prefix = DEF_LLTX_ENDPOINT_PREFIX,
            processing_element = DEF_RU_PROCESSING_ELEMENT,
            tx_array_carrier = DEF_TX_ARRAY_CARRIER
    ):
        for i in range(self.NUM_LLTX_LINKS):
            lltxlink = self.yupobj.user_plane_configuration.\
                low_level_tx_links.add(f"{link_prefix}{i}")
            lltxlink.low_level_tx_endpoint = f"{endpoint_prefix}{i}"
            lltxlink.processing_element = processing_element
            lltxlink.tx_array_carrier = tx_array_carrier
        return self.yupobj.user_plane_configuration.low_level_tx_links

    def mk_uplane_llrx_links(
            self, link_prefix = DEF_LLRX_LINK_PREFIX,
            endpoint_prefix = DEF_LLRX_ENDPOINT_PREFIX,
            processing_element = DEF_RU_PROCESSING_ELEMENT,
            rx_array_carrier = DEF_RX_ARRAY_CARRIER
    ):
        for i in range(self.NUM_LLRX_LINKS):
            llrxlink = self.yupobj.user_plane_configuration.\
                low_level_rx_links.add(f"{link_prefix}{i}")
            llrxlink.low_level_rx_endpoint = f"{endpoint_prefix}{i}"
            llrxlink.processing_element = processing_element
            llrxlink.rx_array_carrier = rx_array_carrier
        return self.yupobj.user_plane_configuration.low_level_rx_links

    def get_uplane_lltx_endpoint(self, name):
        return self.yupobj.user_plane_configuration.low_level_tx_endpoints[name]

    def mk_uplane_lltx_endpoints(
            self, iq_bitwidth = DEF_LLEP_COMPRESSION_IQ_BITWIDTH,
            compression_type = DEF_LLEP_COMPRESSION_TYPE,
            endpoint_prefix = DEF_LLTX_ENDPOINT_PREFIX,
            extra = {}
    ):
        for i in range(self.NUM_LLTX_ENDPOINTS):
            lltxep = self.yupobj.user_plane_configuration.\
                low_level_tx_endpoints.add(f"{endpoint_prefix}{i}")
            lltxep.compression.iq_bitwidth = iq_bitwidth
            lltxep.compression.compression_type = compression_type
            lltxep.compression.fs_offset = self.DEF_LLEP_COMPRESSION_FS_OFFSET
            lltxep.cp_length = self.DEF_LLEP_CP_LENGTH
            lltxep.cp_length_other = self.DEF_LLEP_CP_LENGTH_OTHER
            lltxep.offset_to_absolute_frequency_center = \
                self.DEF_LLEP_ABS_CF_OFFSET
            for m in self.DEF_LLEP_NUM_PRB_PER_SCS_ENTRIES:
                lltxep.number_of_prb_per_scs.add(m['scs'])
                lltxep.number_of_prb_per_scs[m['scs']].\
                    number_of_prb = m['number-of-prb']
            for k, v in self.DEF_LLEP_EAXCID_ATTRS.items():
                setattr(lltxep.e_axcid, self.safe_name(k), v)
                lltxep.e_axcid.eaxc_id = i
            for k, v in extra.items():
                if k in ("compression", "e-axcid"):
                    for j, u in v.items():
                        setattr(getattr(lltxep, self.safe_name(k)),
                                self.safe_name(j), u)
                elif k == "number-of-prb-per-scs":
                    for m in v:
                        if m['scs'] not in lltxep.number_of_prb_per_scs:
                            lltxep.number_of_prb_per_scs.add(m['scs'])
                        lltxep.number_of_prb_per_scs[m['scs']].number_of_prb = \
                            m['number-of-prb']
                else:
                    setattr(lltxep, self.safe_name(k), v)
        return self.yupobj.user_plane_configuration.low_level_tx_endpoints

    def mk_uplane_llrx_endpoints(
            self, iq_bitwidth = DEF_LLEP_COMPRESSION_IQ_BITWIDTH,
            compression_type = DEF_LLEP_COMPRESSION_TYPE,
            endpoint_prefix = DEF_LLRX_ENDPOINT_PREFIX,
            extra = {}
    ):
        for i in range(self.NUM_LLRX_ENDPOINTS):
            llrxep = self.yupobj.user_plane_configuration.\
                low_level_rx_endpoints.add(f"{endpoint_prefix}{i}")
            llrxep.compression.iq_bitwidth = iq_bitwidth
            llrxep.compression.compression_type = compression_type
            llrxep.compression.fs_offset = self.DEF_LLEP_COMPRESSION_FS_OFFSET
            llrxep.cp_length = self.DEF_LLEP_CP_LENGTH
            llrxep.cp_length_other = self.DEF_LLEP_CP_LENGTH_OTHER
            llrxep.offset_to_absolute_frequency_center = \
                self.DEF_LLEP_ABS_CF_OFFSET
            llrxep.non_time_managed_delay_enabled = \
                self.DEF_LLRX_ENDPOINT_NON_TIME_MANAGED_DELAY_ENABLED
            for m in self.DEF_LLEP_NUM_PRB_PER_SCS_ENTRIES:
                llrxep.number_of_prb_per_scs.add(m['scs'])
                llrxep.number_of_prb_per_scs[m['scs']].\
                    number_of_prb = m['number-of-prb']
                # Unclear if this next thing is actually needed.
                llrxep.ul_fft_sampling_offsets.add(m['scs'])
            for k, v in self.DEF_LLEP_EAXCID_ATTRS.items():
                setattr(llrxep.e_axcid, self.safe_name(k), v)
                llrxep.e_axcid.eaxc_id = i
            for k, v in extra.items():
                if k in ("compression", "e-axcid"):
                    for j, u in v.items():
                        setattr(getattr(llrxep, self.safe_name(k)),
                                self.safe_name(j), u)
                elif k == "number-of-prb-per-scs":
                    for m in v:
                        if m['scs'] not in llrxep.number_of_prb_per_scs:
                            llrxep.number_of_prb_per_scs.add(m['scs'])
                        llrxep.number_of_prb_per_scs[m['scs']].number_of_prb = \
                            m['number-of-prb']
                        # Not clear this is needed or correct...
                        llrxep.ul_fft_sampling_offsets.add(m['scs'])
                else:
                    setattr(llrxep, self.safe_name(k), v)
        return self.yupobj.user_plane_configuration.low_level_rx_endpoints

    def get_uplane_tx_array_carrier(self, name):
        return self.yupobj.user_plane_configuration.tx_array_carriers[name]

    def mk_uplane_tx_array_carrier(
            self, center_frequency, bandwidth,
            name = DEF_TX_ARRAY_CARRIER,
            extra = {}
    ):
        txcarr = self.yupobj.user_plane_configuration.\
            tx_array_carriers.add(name)
        txcarr.center_of_channel_bandwidth = center_frequency
        txcarr.absolute_frequency_center = Utilities.cf2arfcn(center_frequency)
        txcarr.channel_bandwidth = bandwidth
        txcarr.active = self.ARRAY_CARRIER_INACTIVE
        txcarr.gain = self.DEF_TX_ARRAY_CARRIER_GAIN
        txcarr.downlink_radio_frame_offset = \
            self.DEF_ARRAY_CARRIER_DL_RADIO_FRAME_OFFSET
        txcarr.downlink_sfn_offset = self.DEF_ARRAY_CARRIER_DL_SFN_OFFSET
        for k, v in extra.items():
            setattr(txcarr, self.safe_name(k), v)
        return txcarr
        
    def mk_uplane_rx_array_carrier(
            self, center_frequency, bandwidth,
            name = DEF_RX_ARRAY_CARRIER,
            extra = {}
    ):
        rxcarr = self.yupobj.user_plane_configuration.\
            rx_array_carriers.add(name)
        rxcarr.center_of_channel_bandwidth = center_frequency
        rxcarr.absolute_frequency_center = Utilities.cf2arfcn(center_frequency)
        rxcarr.channel_bandwidth = bandwidth
        rxcarr.active = self.ARRAY_CARRIER_INACTIVE
        rxcarr.downlink_radio_frame_offset = \
            self.DEF_ARRAY_CARRIER_DL_RADIO_FRAME_OFFSET
        rxcarr.downlink_sfn_offset = self.DEF_ARRAY_CARRIER_DL_SFN_OFFSET
        rxcarr.gain_correction = self.DEF_RX_ARRAY_CARRIER_GAIN_CORRECTION
        rxcarr.n_ta_offset = self.DEF_RX_ARRAY_CARRIER_N_TA_OFFSET
        for k, v in extra.items():
            setattr(rxcarr, self.safe_name(k), v)
        return rxcarr


##############################################################################
#
# VVDN O-RU M-Plane session (over SSHWrapper connection)
#
class VVDNMPlaneSession(object):
    DEF_MPLANE_USER = DEF_MPLANE_PASS = "oranuser"
    DEF_LOG_LEVEL = logging.INFO
    DEF_PING_TIMEOUT = DeviceWrapper.DEF_PING_TIMEOUT

    def __init__(self, mgmt_addr, username=DEF_MPLANE_USER,
                 log_level = DEF_LOG_LEVEL):
        self.lgr = Utilities.mk_logger(self.__class__.__name__, log_level)
        self._addr = mgmt_addr
        self._user = username
        self._mgr = None
        self._connected = False
        self._config = None

    def connect_session(self, password=DEF_MPLANE_PASS,
                        ping_timeout=DEF_PING_TIMEOUT):
        Utilities.wait_for_ping(self._addr, ping_timeout)
        self._mgr = manager.connect_ssh(
            self._addr, username=self._user, password=password,
            hostkey_verify=False)
        self.lgr.info(f"M-Plane session established with {self._addr}, "
                      f"session ID {self._mgr.session_id}")
        self._connected = True

    def is_connected(self):
        return self._connected

    def get_session(self):
        if not self._mgr:
            self.connect_session()
        return self._mgr

    def get_config(self, source = "running", refresh = False):
        if refresh or self._config is None:
            self._config = self.get_session().get_config(source=source)
        return self._config

    def edit_config(self, config, target = "running"):
        return self.get_session().edit_config(target=target, config=config)


##############################################################################
#
# VVDNConfig class definitions. Defines configuration settings and defaults.
#
class VVDNConfig_MPRU_b78(DeviceConfig):
    DEFAULT_SETTINGS = {
        'center_frequency': {
            'def': 3370.2,
            'allowed_ranges': ((3358.0,3700.0),)
        },
        'bandwidth': {
            'def': 20.0,
            'allowed_values': (20.0, 40.0, 60.0, 80.0, 100.0)
        },
        'gain': {
            'def': 37.0,
            'allowed_ranges': ((1.0,37.0),)
        },
        'ofh_vlan': {
            'def': 1,
            'allowed_ranges': ((1,4096),)
        },
        'du_mac': {
            'def': '000000000000',
            'allowed_patterns': (r'[0-9A-Fa-f]{12}',)
        },
        'mimo_mode': {
            'def': '1_2_3_4_4x4',
            'allowed_values': ('1_3','2_4','1_2_3_4_4x2','1_2_3_4_4x4')
        },
        'compression': {
            'def': 'dynamic_compressed',
            'allowed_values': ('static_uncompressed', 'static_compressed',
                               'dynamic_uncompressed', 'dynamic_compressed')
        },
    }

##############################################################################
#
# VVDNWrapper class definition
#
class VVDNWrapper(DeviceWrapper):
    DEF_LOG_LEVEL = logging.INFO
    DEF_USER = "oranuser"
    DEF_PASSWD = "oranuser"
    DEF_PING_TIMEOUT = 5
    DEF_BOOT_TIMEOUT = 120
    DEF_SHUTDOWN_TIME = 30
    DEF_RADIO_ONLINE_TIMEOUT = 300
    WAIT_LOG_SLEEP = 1
    FW_VERSION_UNKNOWN = "YYYYMMDDHHMMSS"
    FW_VERSION_FILE = "/etc/version"

    def __init__(self, mgmt_addr, username=DEF_USER, keyfile=None,
                 log_level = DEF_LOG_LEVEL):
        super().__init__(mgmt_addr, username, keyfile, log_level)
        self._mpsess = VVDNMPlaneSession(
            mgmt_addr, username, log_level=log_level)
        self._mpconf = MPlaneConfig(str(self._mpsess.get_config()))

    def connect_session(self, password = DEF_PASSWD, connect_ssh = False,
                        ping_timeout = DEF_PING_TIMEOUT):
        if connect_ssh:
            super().connect_session(password, ping_timeout)
        self._mpsess.connect_session(password, ping_timeout)

    def get_session(self):
        raise RuntimeError(
            f"{Utilities.whoami(self)}: Do not call this method! It is "
            "ambiguous in this class since multiple sessions exist.")

    def get_ssh_session(self):
        return super().get_session()

    def get_mplane_session(self):
        if not self._mpsess.is_connected():
            self.connect_session()
        return self._mpsess

    def fetch_settings(self):
        settings = VVDNConfig_MPRU_b78()
        txcarr = self._mpconf.\
            get_uplane_tx_array_carrier(MPlaneConfig.DEF_TX_ARRAY_CARRIER)
        ethflow = self._mpconf.\
            find_ru_processing_element(MPlaneConfig.DEF_RU_PROCESSING_ELEMENT).\
            transport_flow.eth_flow
        txep = self._mpconf.\
            get_uplane_lltx_endpoint(f"{MPlaneConfig.DEF_LLTX_ENDPOINT_PREFIX}0")
        settings['center_frequency'] = txcarr.center_of_channel_bandwidth / 1e6
        settings['bandwidth'] = txcarr.channel_bandwidth / 1e6
        settings['gain'] = txcarr.gain
        settings['ofh_vlan'] = ethflow.vlan_id
        settings['du_mac'] = ethflow.o_du_mac_address.replace(':', '')
        cmpmeth = 'uncompressed' \
            if txep.compression.compression_method == 'NO_COMPRESSION' \
               else 'compressed'
        settings['compression'] = \
            f"{txep.compression.compression_type.lower()}_{cmpmeth}"
        return settings

    def push_settings(self):
        pass
