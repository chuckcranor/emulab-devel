#!/usr/bin/env python

#
# This library contains the specific device proxy support for VVDN O-RU
# devices, for device configuration, status, and management.
#
# Note: Power control and reboot are handled by the standard testbed
#       `node_reboot` and `power` scripts. Modules specifically for
#       handling VVDN RUs should be present in these scripts. They use
#       this script to check device status and wait for initialization
#       to complete.

import logging
import re
import sys
import time
from lxml import etree
from abc import ABC, abstractmethod
from ncclient import manager

sys.path.append("@prefix@/lib")
from libdevproxy import Utilities, DeviceConfig, DeviceWrapper

##############################################################################
#
# classes for individual M-Plane config elements
#
class MPlaneDefs(object):
    NS_DEFAULT = "urn:ietf:params:xml:ns:netconf:base:1.0"
    NS_PROCELT = "urn:o-ran:processing-element:1.0"
    NS_UPCONF  = "urn:o-ran:uplane-conf:1.0"
    NS_INTERFACES = "urn:ietf:params:xml:ns:yang:ietf-interfaces"
    NS_ORANIFACES = "urn:o-ran:interfaces:1.0"
    NS_IFTYPE = "urn:ietf:params:xml:ns:yang:iana-if-type"
    NS_IFIP = "urn:ietf:params:xml:ns:yang:ietf-ip"

# This function will only run once, no matter how many times this module
# is imported.
def _init_xml():
    if not hasattr(_init_xml, "has_run"):
        #etree.register_namespace(None, MPlaneDefs.NS_DEFAULT)
        etree.register_namespace('procelt', MPlaneDefs.NS_PROCELT)
        etree.register_namespace('upconf', MPlaneDefs.NS_UPCONF)
        etree.register_namespace('interfaces', MPlaneDefs.NS_INTERFACES)
        etree.register_namespace('ifref', MPlaneDefs.NS_ORANIFACES)
        etree.register_namespace('iftype', MPlaneDefs.NS_IFTYPE)
        etree.register_namespace('ifip', MPlaneDefs.NS_IFIP)
    _init_xml.has_run = True
_init_xml()

# Abstract class for all MPlane configuration objects.
class MPlaneObject(ABC):
    @abstractmethod
    def generate_xml(self):
        raise RuntimeError("Child class must implement this method!")

    def pretty_print(self):
        print(etree.tostring(self.generate_xml(), encoding=str, pretty_print=True))

class MPlaneInterface(MPlaneObject):
    def __init__(self, xmlobj):
        self.name = xmlobj.find(f"{{{MPlaneDefs.NS_INTERFACES}}}name").text
        self.iftype = xmlobj.find(f"{{{MPlaneDefs.NS_INTERFACES}}}type").text.split(':')[1]
        enabled = xmlobj.find(f"{{{MPlaneDefs.NS_INTERFACES}}}enabled").text
        self.enabled = True if enabled.lower() == 'true' else False
        ip = xmlobj.find(f".//{{{MPlaneDefs.NS_IFIP}}}ip")
        self.ipaddr = ip.text if ip is not None else None
        netmask = xmlobj.find(f".//{{{MPlaneDefs.NS_IFIP}}}netmask")
        self.netmask = netmask.text if netmask is not None else None
        self.mac = xmlobj.find(f"{{{MPlaneDefs.NS_ORANIFACES}}}mac-address").text
        baseif = xmlobj.find(f"{{{MPlaneDefs.NS_ORANIFACES}}}base-interface")
        self.baseif = baseif.text if baseif is not None else None
        vlanid = xmlobj.find(f"{{{MPlaneDefs.NS_ORANIFACES}}}vlan-id")
        self.vlanid = vlanid.text if vlanid is not None else None
        mtu = xmlobj.find(f"{{{MPlaneDefs.NS_ORANIFACES}}}l2-mtu")
        self.mtu = int(mtu.text) if mtu is not None else None
        pref = xmlobj.find(f"{{{MPlaneDefs.NS_ORANIFACES}}}port-reference")
        self.port_name = pref.find(f"{{{MPlaneDefs.NS_ORANIFACES}}}port-name").text if pref is not None else None
        self.port_num = int(pref.find(f"{{{MPlaneDefs.NS_ORANIFACES}}}port-number").text) if pref is not None else None

    def generate_xml(self):
        ifelt = etree.Element(f"{{{MPlaneDefs.NS_INTERFACES}}}interface")
        etree.SubElement(ifelt, f"{{{MPlaneDefs.NS_INTERFACES}}}name").text = self.name
        etree.SubElement(ifelt, f"{{{MPlaneDefs.NS_INTERFACES}}}type", nsmap={"iftype": MPlaneDefs.NS_IFTYPE}).text = f"iftype:{self.iftype}"
        etree.SubElement(ifelt, f"{{{MPlaneDefs.NS_INTERFACES}}}enabled").text = str(self.enabled).lower()
        etree.SubElement(ifelt, f"{{{MPlaneDefs.NS_ORANIFACES}}}mac-address").text = self.mac
        if self.ipaddr is not None and self.netmask is not None:
            ipv4elt = etree.SubElement(ifelt, f"{{{MPlaneDefs.NS_IFIP}}}ipv4")
            etree.SubElement(ipv4elt, f"{{{MPlaneDefs.NS_IFIP}}}enabled").text = "true"
            addrelt = etree.SubElement(ipv4elt, f"{{{MPlaneDefs.NS_IFIP}}}address")
            etree.SubElement(addrelt, f"{{{MPlaneDefs.NS_IFIP}}}ip").text = self.ipaddr
            etree.SubElement(addrelt, f"{{{MPlaneDefs.NS_IFIP}}}netmask").text = self.netmask
        if self.mtu is not None:
            etree.SubElement(ifelt, f"{{{MPlaneDefs.NS_ORANIFACES}}}l2-mtu").text = str(self.mtu)
        if self.baseif is not None:
            etree.SubElement(ifelt, f"{{{MPlaneDefs.NS_ORANIFACES}}}base-interface").text = self.baseif
        if self.vlanid is not None:
            etree.SubElement(ifelt, f"{{{MPlaneDefs.NS_ORANIFACES}}}vlan-id").text = self.vlanid
        if self.port_name is not None and self.port_num is not None:
            prefelt = etree.SubElement(ifelt, f"{{{MPlaneDefs.NS_ORANIFACES}}}port-reference")
            etree.SubElement(prefelt, f"{{{MPlaneDefs.NS_ORANIFACES}}}port-name").text = self.port_name
            etree.SubElement(prefelt, f"{{{MPlaneDefs.NS_ORANIFACES}}}port-number").text = str(self.port_num)
        return ifelt

class MPlaneProcessingElements(MPlaneObject):
    def __init__(self, xmlobj):
        self.name = xmlobj.find(f".//{{{MPlaneDefs.NS_PROCELT}}}name").text
        self.ifname = xmlobj.find(f".//{{{MPlaneDefs.NS_PROCELT}}}interface-name").text
        self.rumac = xmlobj.find(f".//{{{MPlaneDefs.NS_PROCELT}}}ru-mac-address").text
        self.dumac = xmlobj.find(f".//{{{MPlaneDefs.NS_PROCELT}}}o-du-mac-address").text
        self.vlanid = xmlobj.find(f".//{{{MPlaneDefs.NS_PROCELT}}}vlan-id").text

    def generate_xml(self):
        pelt = etree.Element(f"{{{MPlaneDefs.NS_PROCELT}}}processing-elements")
        etree.SubElement(pelt, f"{{{MPlaneDefs.NS_PROCELT}}}transport-session-type").text = "ETH-INTERFACE"
        ruelt = etree.SubElement(pelt, f"{{{MPlaneDefs.NS_PROCELT}}}ru-elements")
        etree.SubElement(ruelt, f"{{{MPlaneDefs.NS_PROCELT}}}name").text = self.name
        tfelt = etree.SubElement(ruelt, f"{{{MPlaneDefs.NS_PROCELT}}}transport-flow")
        etree.SubElement(tfelt, f"{{{MPlaneDefs.NS_PROCELT}}}interface-name").text = self.ifname
        ethelt = etree.SubElement(tfelt, f"{{{MPlaneDefs.NS_PROCELT}}}eth-flow")
        etree.SubElement(ethelt, f"{{{MPlaneDefs.NS_PROCELT}}}ru-mac-address").text = self.rumac
        etree.SubElement(ethelt, f"{{{MPlaneDefs.NS_PROCELT}}}o-du-mac-address").text = self.dumac
        etree.SubElement(ethelt, f"{{{MPlaneDefs.NS_PROCELT}}}vlan-id").text = self.vlanid
        return pelt

class MPlaneLLTXLink(MPlaneObject):
    def __init__(self, xmlobj):
        self.name = xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}name").text
        self.proc_elt = xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}processing-element").text
        self.arr_carr = xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}tx-array-carrier").text
        self.endpoint = xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}low-level-tx-endpoint").text

    def generate_xml(self):
        lltxelt = etree.Element(f"{{{MPlaneDefs.NS_UPCONF}}}low-level-tx-links")
        etree.SubElement(lltxelt, f"{{{MPlaneDefs.NS_UPCONF}}}name").text = self.name
        etree.SubElement(lltxelt, f"{{{MPlaneDefs.NS_UPCONF}}}processing-element").text = self.proc_elt
        etree.SubElement(lltxelt, f"{{{MPlaneDefs.NS_UPCONF}}}tx-array-carrier").text = self.arr_carr
        etree.SubElement(lltxelt, f"{{{MPlaneDefs.NS_UPCONF}}}low-level-tx-endpoint").text = self.endpoint
        return lltxelt

class MPlaneLLRXLink(MPlaneObject):
    def __init__(self, xmlobj):
        self.name = xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}name").text
        self.proc_elt = xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}processing-element").text
        self.arr_carr = xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}rx-array-carrier").text
        self.endpoint = xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}low-level-rx-endpoint").text

    def generate_xml(self):
        llrxelt = etree.Element(f"{{{MPlaneDefs.NS_UPCONF}}}low-level-rx-links")
        etree.SubElement(llrxelt, f"{{{MPlaneDefs.NS_UPCONF}}}name").text = self.name
        etree.SubElement(llrxelt, f"{{{MPlaneDefs.NS_UPCONF}}}processing-element").text = self.proc_elt
        etree.SubElement(llrxelt, f"{{{MPlaneDefs.NS_UPCONF}}}rx-array-carrier").text = self.arr_carr
        etree.SubElement(llrxelt, f"{{{MPlaneDefs.NS_UPCONF}}}low-level-rx-endpoint").text = self.endpoint
        return llrxelt

class MPlaneLLTXEndpoint(MPlaneObject):
    def __init__(self, xmlobj):
        self.name = xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}name").text
        self.bitwidth = int(xmlobj.find(f".//{{{MPlaneDefs.NS_UPCONF}}}iq-bitwidth").text)
        self.cmp_type = xmlobj.find(f".//{{{MPlaneDefs.NS_UPCONF}}}compression-type").text
        self.fs_off = int(xmlobj.find(f".//{{{MPlaneDefs.NS_UPCONF}}}fs-offset").text)
        self.cp_len = int(xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}cp-length").text)
        self.cp_len_other = int(xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}cp-length-other").text)
        self.abs_off = int(xmlobj.find(f"./{{{MPlaneDefs.NS_UPCONF}}}offset-to-absolute-frequencty-center").text)
        self.prb_scs = xmlobj.find(f".//{{{MPlaneDefs.NS_UPCONF}}}scs").text
        self.num_prb = int(xmlobj.find(f".//{{{MPlaneDefs.NS_UPCONF}}}number-of-prb").text)
        self.eaxcid_du_bm = int(xmlobj.find(f".//{{{MPlaneDefs.NS_UPCONF}}}o-du-port-bitmask").text)
        self.eaxcid_bs_bm = int(xmlobj.find(f".//{{{MPlaneDefs.NS_UPCONF}}}band-sector-bitmask").text)
        self.eaxcid_ccid_bm = int(xmlobj.find(f".//{{{MPlaneDefs.NS_UPCONF}}}ccid-bitmask").text)
        self.eaxcid_ru_bm = int(xmlobj.find(f".//{{{MPlaneDefs.NS_UPCONF}}}ru-port-bitmask").text)
        self.eaxcid_id = int(xmlobj.find(f".//{{{MPlaneDefs.NS_UPCONF}}}eaxc-id").text)

    def generate_xml(self):
        lltxelt = etree.Element(f"{{{MPlaneDefs.NS_UPCONF}}}low-level-tx-endpoints")
        etree.SubElement(lltxelt, f"{{{MPlaneDefs.NS_UPCONF}}}name").text = self.name
        cmpelt = etree.SubElement(lltxelt, f"{{{MPlaneDefs.NS_UPCONF}}}compression")
        etree.SubElement(cmpelt, f"{{{MPlaneDefs.NS_UPCONF}}}iq-bitwidth").text = str(self.bitwidth)
        etree.SubElement(cmpelt, f"{{{MPlaneDefs.NS_UPCONF}}}compression-type").text = self.cmp_type
        etree.SubElement(cmpelt, f"{{{MPlaneDefs.NS_UPCONF}}}fs-offset").text = str(self.fs_off)
        etree.SubElement(lltxelt, f"{{{MPlaneDefs.NS_UPCONF}}}cp-length").text = str(self.cp_len)
        etree.SubElement(lltxelt, f"{{{MPlaneDefs.NS_UPCONF}}}cp-length-other").text = str(self.cp_len_other)
        etree.SubElement(lltxelt, f"{{{MPlaneDefs.NS_UPCONF}}}offset-to-absolute-frequency-center").text = str(self.abs_off)
        # TODO: finish
        return lltxelt
        
##############################################################################
#
# VVDN O-RU M-Plane session (over SSHWrapper connection)
#
class VVDNMPlaneSession(object):
    DEF_MPLANE_USER = DEF_MPLANE_PASS = "oranuser"
    DEF_LOG_LEVEL = logging.INFO
    DEF_PING_TIMEOUT = DeviceWrapper.DEF_PING_TIMEOUT

    def __init__(self, mgmt_addr, username=DEF_MPLANE_USER,
                 log_level = DEF_LOG_LEVEL):
        self.lgr = Utilities.mk_logger(self.__class__.__name__, log_level)
        self._addr = mgmt_addr
        self._user = username
        self._mgr = None
        self._connected = False
        self._config = None

    def connect_session(self, password=DEF_MPLANE_PASS,
                        ping_timeout=DEF_PING_TIMEOUT):
        Utilities.wait_for_ping(self._addr, ping_timeout)
        self._mgr = manager.connect_ssh(
            self._addr, username=self._user, password=password,
            hostkey_verify=False)
        self.lgr.info(f"M-Plane session established with {self._addr}, "
                      f"session ID {self._mgr.session_id}")
        self._connected = True

    def is_connected(self):
        return self._connected

    def get_session(self):
        if not self._mgr:
            self.connect_session()
        return self._mgr

    def get_config(self, refresh = False):
        if refresh or self._config is None:
            self._config = self.get_session().get_config(source="running").data
        return self._config

    def get_interfaces(self):
        ifaces = self.get_config().find(f"{{{MPlaneDefs.NS_INTERFACES}}}interfaces")
        rvals = []
        for iface in ifaces:
            rvals.append(MPlaneInterface(iface))
        return rvals

    def get_processing_elements(self):
        procelts = self.get_config().find(f"{{{MPlaneDefs.NS_PROCELT}}}processing-elements")
        return MPlaneProcessingElements(procelts)

