package libradius;
use Exporter;

@ISA = "Exporter";
@EXPORT = 
    qw ( radius_setup radius_teardown );

use lib '@prefix@/lib';
use libdb;
use English;

sub radius_setup($$) {
    my ($pid,$eid) = @_;

    # we need entries for every user with trust greater than user
    # and every access_ip for a resource belonging to an exclusively owned
    # scenario instance.
    my $qr = 
	DBQueryFatal("select distinct " . 
		     "sra.IP, gm.uid, gm.trust, u.usr_pswd " .
		     "from group_membership as gm " .
		     "left join experiments as e " .
		     "on gm.gid=e.gid and gm.pid=e.pid " .
		     "left join experiment_scenarios as es " .
		     "on es.pid=e.pid and es.eid=e.eid " .
		     "left join scenario_resources as sr " .
		     "on sr.scenario_id=es.scenario_id " .
		     "and sr.scenario_instance=es.scenario_instance " .
		     "left join scenario_router_access as sra " .
		     "on sra.resource_id = sr.resource_id " .
		     "left join users as u " .
		     "on u.uid=gm.uid " .
		     "where e.eid=\"$eid\" and e.pid=\"$pid\" " .
		     "and es.resource_policy='exclusive' " .
		     "and sra.IP is not null " .
		     "and trust in " .
		     "('local_root', 'group_root', 'project_root', 'user')");
    while (my ($ip,$uid,$trust,$pswd) = $qr->fetchrow_array()) {
	DBQueryFatal("insert into radius_check set " .
		     "pid=\"$pid\", eid=\"$eid\", uid=\"$uid\", " .
		     "nisip=\"$ip\", name=\"Crypt-Password\", op=\"==\", " .
		     "value=\"$pswd\"");
	DBQueryFatal("insert into radius_check set " .
		     "pid=\"$pid\", eid=\"$eid\", uid=\"$uid\", " .
		     "nisip=\"$ip\", name=\"NAS-IP-Address\", op=\"==\", " .
		     "value=\"$ip\"");
#	DBQueryFatal("insert into radius_check set " .
#		     "pid=\"$pid\", eid=\"$eid\", uid=\"$uid\", " .
#		     "nisip=\"$ip\", name=\"Authentication-Type\", op=\"==\", " .
#		     "value=\"Local\"");
	DBQueryFatal("insert into radius_reply set " .
		     "pid=\"$pid\", eid=\"$eid\", uid=\"$uid\", " .
		     "nisip=\"$ip\", name=\"service-type\", op=\":=\", " .
		     "value=\"Login-user\"");
	DBQueryFatal("insert into radius_reply set " .
		     "pid=\"$pid\", eid=\"$eid\", uid=\"$uid\", " .
		     "nisip=\"$ip\", name=\"cisco-avpair\", op=\":=\", " .
		     "value=\"shell:priv-lvl=" . 
		     ($trust eq 'user' ? "1" : "15") . 
		     "\"");
    }
};

sub radius_teardown($$) {
    my ($pid,$eid) = @_;

    DBQueryFatal("delete from radius_check where pid=\"$pid\" and eid=\"$eid\"");
    DBQueryFatal("delete from radius_reply where pid=\"$pid\" and eid=\"$eid\"");
}

# _Always_ make sure that this 1 is at the end of the file...
1;
